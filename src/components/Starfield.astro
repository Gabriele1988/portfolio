---
// Sfondo stellato in movimento lento, come su andreavannetti.dev: quattro livelli di "stelle"
// disegnate con box-shadow su un elemento di 1px, che scivolano in diagonale.
// Le posizioni sono generate nel browser, così l'HTML resta leggero.
---

<div class="starfield" aria-hidden="true">
  <div class="layer slow" data-stars="1500" data-blur="0"></div>
  <div class="layer medium" data-stars="600" data-blur="0.5"></div>
  <div class="layer fast" data-stars="200" data-blur="0.5"></div>
  <div class="layer glow" data-stars="60" data-blur="0.4" data-color="26, 163, 174" data-max="0.35"></div>
  <div class="comete" data-comete></div>
</div>

<script>
  const AREA = 4000;
  for (const el of document.querySelectorAll<HTMLElement>('.starfield .layer')) {
    const n = Number(el.dataset.stars);
    const blur = Number(el.dataset.blur);
    const color = el.dataset.color ?? '224, 226, 219';
    const max = Number(el.dataset.max ?? 0.8);
    const shadows: string[] = [];
    for (let i = 0; i < n; i++) {
      const a = (0.3 + Math.random() * (max - 0.3)).toFixed(2);
      const x = Math.floor(Math.random() * AREA);
      const y = Math.floor(Math.random() * AREA);
      shadows.push(`rgba(${color}, ${a}) ${x}px ${y}px ${(Math.random() * blur).toFixed(1)}px`);
    }
    el.style.boxShadow = shadows.join(',');
  }

  // Comete: ogni tanto una scia luminosa attraversa il cielo in diagonale.
  const cielo = document.querySelector<HTMLElement>('[data-comete]')!;
  const calmo = matchMedia('(prefers-reduced-motion: reduce)');
  const rand = (min: number, max: number) => min + Math.random() * (max - min);

  function cometa() {
    if (!calmo.matches && document.visibilityState === 'visible') {
      const w = window.innerWidth;
      const h = window.innerHeight;
      const verde = Math.random() < 0.25;
      const angolo = rand(18, 38) * (Math.random() < 0.5 ? 1 : -1); // gradi sotto l'orizzontale
      const verso = angolo > 0 ? 1 : -1; // 1 = verso destra
      const lunghezza = rand(120, 220);
      const distanza = rand(0.45, 0.8) * Math.hypot(w, h);
      const x = verso > 0 ? rand(-0.1, 0.6) * w : rand(0.4, 1.1) * w;
      const y = rand(-0.1, 0.45) * h;
      const rad = (Math.abs(angolo) * Math.PI) / 180;
      const dx = Math.cos(rad) * distanza * verso;
      const dy = Math.sin(rad) * distanza;
      const ruota = verso > 0 ? Math.abs(angolo) : 180 - Math.abs(angolo);

      const c = document.createElement('span');
      c.className = verde ? 'cometa verde' : 'cometa';
      c.style.width = `${lunghezza}px`;
      cielo.append(c);
      c.animate(
        [
          { transform: `translate(${x}px, ${y}px) rotate(${ruota}deg) scaleX(0.2)`, opacity: 0 },
          { opacity: 1, offset: 0.15 },
          { opacity: 1, offset: 0.7 },
          { transform: `translate(${x + dx}px, ${y + dy}px) rotate(${ruota}deg) scaleX(1)`, opacity: 0 },
        ],
        { duration: rand(1100, 1900), easing: 'cubic-bezier(.2,.6,.4,1)' },
      ).onfinish = () => c.remove();
    }
    setTimeout(cometa, rand(1500, 4500));
  }
  setTimeout(cometa, rand(800, 2000));
</script>

<style>
  .starfield { position: fixed; inset: 0; z-index: -1; overflow: hidden; pointer-events: none; }
  .layer { position: absolute; top: 0; left: 0; width: 1px; height: 1px; border-radius: 50%; will-change: transform; }
  .medium, .glow { width: 1.5px; height: 1.5px; }
  .fast { width: 2px; height: 2px; }
  .slow { animation: drift-slow 250s linear infinite; }
  .medium { animation: drift-medium 180s linear infinite; }
  .fast { animation: drift-fast 120s linear infinite; }
  .glow { animation: drift-medium 150s linear infinite; }
  @keyframes drift-slow { to { transform: translate(-2000px, -2000px); } }
  @keyframes drift-medium { to { transform: translate(-2500px, -1500px); } }
  @keyframes drift-fast { to { transform: translate(-1500px, -2500px); } }
  /* La testa della cometa è a destra, la coda sfuma verso sinistra (rispetto alla direzione di volo). */
  .comete :global(.cometa) {
    position: absolute;
    top: 0;
    left: 0;
    height: 1.5px;
    transform-origin: 100% 50%;
    border-radius: 999px;
    background: linear-gradient(90deg, transparent, rgb(224 226 219 / 0.15) 40%, rgb(255 255 255 / 0.95));
    filter: drop-shadow(0 0 4px rgb(255 255 255 / 0.6));
    opacity: 0;
    will-change: transform, opacity;
  }
  .comete :global(.cometa.verde) {
    background: linear-gradient(90deg, transparent, rgb(11 135 147 / 0.15) 40%, rgb(110 215 222 / 0.95));
    filter: drop-shadow(0 0 5px rgb(11 135 147 / 0.7));
  }
  @media (prefers-reduced-motion: reduce) {
    .layer { animation: none; }
  }
</style>
