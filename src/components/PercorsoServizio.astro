</div>

<script>
  type Punto = { x: number; y: number };
  const desktop = matchMedia('(min-width: 48rem)');

  for (const el of document.querySelectorAll<HTMLElement>('[data-percorso]')) {
    const svg = el.querySelector<SVGSVGElement>('[data-tracciato]')!;
    const base = el.querySelector<SVGPathElement>('[data-base]')!;
    const pieno = el.querySelector<SVGPathElement>('[data-pieno]')!;
    const scia = el.querySelector<SVGLinearGradientElement>('[data-scia]')!;
    const navicella = el.querySelector<HTMLElement>('[data-navicella]')!;
    const scafo = el.querySelector<HTMLElement>('[data-scafo]')!;
    const arrivo = el.querySelector<HTMLElement>('[data-arrivo]')!;
    const passi = [...el.querySelectorAll<HTMLElement>('[data-passo]')];
    const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Campioni del tracciato (x, y, lunghezza) per trovare in fretta il punto all'altezza dello schermo.
    let lunghezza = 0;
    let cx: number[] = [];
    let cy: number[] = [];
    let cl: number[] = [];
    let lunghezzaNodi: number[] = [];


    function indiceA(y: number) {
      let lo = 0;
      let hi = cy.length - 1;
      while (lo < hi) {
        const m = (lo + hi) >> 1;
        if (cy[m] < y) lo = m + 1;
        else hi = m;
      }
      return lo;
    }

    function disegna() {
      const W = el.clientWidth;
      const H = el.clientHeight;
      if (!W || !H) return;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      scia.setAttribute('y2', String(H));

      type Tratto = [Punto, Punto, Punto, Punto];
      const card: DOMRect[] = [];
      const nodi: Punto[] = [];
      for (const li of passi) {
        const c = li.querySelector<HTMLElement>('[data-card]')!;
        const nodo = li.querySelector<HTMLElement>('[data-nodo]')!;
        card.push(new DOMRect(li.offsetLeft + c.offsetLeft, li.offsetTop + c.offsetTop, c.offsetWidth, c.offsetHeight));
        nodi.push({ x: li.offsetLeft + nodo.offsetLeft + nodo.offsetWidth / 2, y: li.offsetTop + nodo.offsetTop + nodo.offsetHeight / 2 });
      }
      const margine = 14;
      const libero = (tt: Tratto[]) =>
        tt.every(([p0, p1, p2, p3]) => {
          for (let t = 0.02; t < 1; t += 0.02) {
            const u = 1 - t;
            const x = u * u * u * p0.x + 3 * u * u * t * p1.x + 3 * u * t * t * p2.x + t * t * t * p3.x;
            const y = u * u * u * p0.y + 3 * u * u * t * p1.y + 3 * u * t * t * p2.y + t * t * t * p3.y;
            if (card.some((r) => x > r.left - margine && x < r.right + margine && y > r.top - margine && y < r.bottom + margine)) return false;
          }
          return true;
        });

      // Desktop: una curva continua (spline) passa da un nodo all'altro, senza pieghe.
      // Dove passerebbe sopra una card, la curva si "tende" un po' in quel punto finché non la tocca più.
      const punti: Punto[] = [];
      punti.push({ x: W / 2, y: 0 }, ...nodi, { x: W / 2, y: H });
      const morbidezza = punti.map(() => 1);
      const costruisci = () =>
        punti.slice(0, -1).map((p, i): Tratto => {
          const q = punti[i + 1];
          const tangente = (k: number) => {
            const prima = punti[Math.max(0, k - 1)];
            const dopo = punti[Math.min(punti.length - 1, k + 1)];
            return { x: ((dopo.x - prima.x) / 5) * morbidezza[k], y: (dopo.y - prima.y) / 3.2 };
          };
          const tp = tangente(i);
          const tq = tangente(i + 1);
          return [p, { x: p.x + tp.x, y: p.y + tp.y }, { x: q.x - tq.x, y: q.y - tq.y }, q];
        });
      let tratti = costruisci();
      if (desktop.matches) {
        for (let giro = 0; giro < 8; giro++) {
          let ok = true;
          tratti.forEach((t, i) => {
            if (!libero([t])) {
              ok = false;
              morbidezza[i] *= 0.6;
              morbidezza[i + 1] *= 0.6;
            }
          });
          if (ok) break;
          tratti = costruisci();
        }
      } else {
        // Telefono: il sentiero scende nella striscia accanto alla card e cambia lato tra una card e l'altra
        // con una lunga curva a S (verticale alle estremità, quindi senza pieghe).
        const s = (a: Punto, b: Punto): Tratto => {
          const k = (b.y - a.y) * 0.5;
          return [a, { x: a.x, y: a.y + k }, { x: b.x, y: b.y - k }, b];
        };
        tratti = [];
        let da: Punto = { x: nodi[0]?.x ?? W / 2, y: 0 };
        nodi.forEach((n, i) => {
          const a = { x: n.x, y: card[i].top };
          const b = { x: n.x, y: card[i].bottom };
          tratti.push(s(da, a), s(a, n), s(n, b));
          da = b;
        });
        tratti.push(s(da, { x: da.x, y: H }));
      }
      const fine = tratti[tratti.length - 1][3];
      arrivo.style.left = `${fine.x}px`;
      let d = `M ${tratti[0][0].x} ${tratti[0][0].y}`;
      for (const [, c1, c2, p] of tratti) d += ` C ${c1.x} ${c1.y} ${c2.x} ${c2.y} ${p.x} ${p.y}`;
      base.setAttribute('d', d);
      pieno.setAttribute('d', d);

      lunghezza = pieno.getTotalLength();
      pieno.style.strokeDasharray = `${lunghezza} ${lunghezza}`;
      const passo = 3;
      cx = [];
      cy = [];
      cl = [];
      let maxY = -Infinity;
      for (let l = 0; l <= lunghezza; l += passo) {
        const p = pieno.getPointAtLength(l);
        maxY = Math.max(maxY, p.y); // y sempre crescente: la ricerca binaria resta valida
        cx.push(p.x);
        cy.push(maxY);
        cl.push(l);
      }
      lunghezzaNodi = nodi.map((n) => cl[indiceA(n.y)]);
    }

    let ultimaY = scrollY;
    let inCoda = false;
    function aggiorna() {
      inCoda = false;
      if (!cl.length) return;
      const dy = scrollY - ultimaY;
      if (Math.abs(dy) > 4) {
        scafo.classList.toggle('su', dy < 0);
        ultimaY = scrollY;
      }
      const r = el.getBoundingClientRect();
      const punta = calmo ? Infinity : innerHeight * 0.55 - r.top;
      const i = punta <= 0 ? 0 : Math.min(cl.length - 1, indiceA(punta));
      const l = cl[i];
      pieno.style.strokeDashoffset = String(lunghezza - l);

      // L'ufo resta dritto e si inclina un po' verso dove sta andando il sentiero.
      const i0 = Math.max(0, i - 2);
      const i1 = Math.min(cl.length - 1, i + 2);
      const lx = Math.hypot(cx[i1] - cx[i0], cy[i1] - cy[i0]) || 1;
      const angolo = (((cx[i1] - cx[i0]) / lx) * 22) * (scafo.classList.contains('su') ? -1 : 1);
      navicella.style.transform = `translate3d(${cx[i]}px, ${cy[i]}px, 0) rotate(${angolo.toFixed(1)}deg)`;
      el.classList.toggle('in-volo', i > 0 && i < cl.length - 1);

      let attivo: HTMLElement | undefined;
      passi.forEach((p, k) => {
        const raggiunto = lunghezzaNodi[k] <= l + 1;
        p.classList.toggle('raggiunto', raggiunto);
        if (raggiunto) attivo = p;
      });
      passi.forEach((p) => p.classList.toggle('attivo', p === attivo));
      arrivo.classList.toggle('raggiunto', i >= cl.length - 2);
    }
    const pianifica = () => {
      if (!inCoda) {
        inCoda = true;
        requestAnimationFrame(aggiorna);
      }
    };

    if (calmo) {
      el.classList.add('fermo');
      passi.forEach((p) => p.classList.add('visibile'));
    } else {
      const io = new IntersectionObserver(
        (voci) => {
          for (const v of voci) {
            if (v.isIntersecting) {
              v.target.classList.add('visibile');
              io.unobserve(v.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      passi.forEach((p) => io.observe(p));
      addEventListener('scroll', pianifica, { passive: true });
    }
    new ResizeObserver(() => {
      disegna();
      aggiorna();
    }).observe(el);
  }
</script>

<style>
