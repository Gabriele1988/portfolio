    transform: translateY(1.5rem) scale(0.98);
    transition: border-color 0.4s, box-shadow 0.5s, opacity 0.6s ease, transform 0.7s cubic-bezier(.2, .8, .2, 1);
  }
  /* Luce del razzo che attraversa il box */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(260px circle at var(--mx) var(--my), color-mix(in srgb, var(--accent-light) 22%, transparent), transparent 70%);
    opacity: 0;
    transition: opacity 0.35s;
    pointer-events: none;
  }
  .card.illuminato::before { opacity: 1; }
  .visibile .card { opacity: 1; transform: none; }
  .raggiunto .card { border-color: var(--accent-border); }
  .card.illuminato { border-color: color-mix(in srgb, var(--accent-light) 60%, transparent); box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent-light) 25%, transparent), 0 18px 50px -20px color-mix(in srgb, var(--accent-light) 60%, transparent); }
  .card > * { position: relative; margin: 0; }

  .segno { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.9rem !important; }
  .numero { font-family: var(--font-display); font-size: 1.75rem; line-height: 1; letter-spacing: 0.02em; color: var(--muted); transition: color 0.4s; }
