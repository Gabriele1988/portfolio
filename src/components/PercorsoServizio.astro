---
// Percorso di un servizio, fase per fase, su una linea verticale che si riempie scorrendo.
// Una navicella viaggia sulla punta della linea: guarda in basso quando scendi e in alto quando risali.
// Le fasi che ha già superato restano accese; in fondo c'è il pianeta d'arrivo.
// Con "riduci movimento" la linea è piena, la navicella è ferma all'arrivo e le fasi sono tutte visibili.
import Icona from './Icona.astro';
import type { Passo } from '../lib/pagineServizi';

interface Props {
  passi: Passo[];
}
const { passi } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="percorso" data-percorso>
  <div class="linea" aria-hidden="true"><span data-riempimento></span></div>

  <div class="navicella" aria-hidden="true" data-navicella>
    <div class="scafo" data-scafo>
      <svg viewBox="0 0 40 72" width="42" height="76">
        <defs>
          <linearGradient id="nv-fiamma" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" />
            <stop offset="0.35" stop-color="rgb(240 138 255)" />
            <stop offset="1" stop-color="rgb(97 9 250)" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="nv-corpo" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#fff" />
            <stop offset="1" stop-color="#d9ccff" />
          </linearGradient>
        </defs>
        <path class="fiamma" d="M13.5 47 Q20 74 26.5 47Z" fill="url(#nv-fiamma)" />
        <path d="M11 30 L3 44 Q3 47 6 46 L11 43Z M29 30 L37 44 Q37 47 34 46 L29 43Z" fill="rgb(97 9 250)" />
        <path d="M20 2 C29 10 31.5 22 30 44 L10 44 C8.5 22 11 10 20 2Z" fill="url(#nv-corpo)" />
        <path d="M20 2 C24.5 6 27 10 28.3 15 L11.7 15 C13 10 15.5 6 20 2Z" fill="rgb(229 0 255)" />
        <circle cx="20" cy="25" r="5.2" fill="rgb(80 0 244)" stroke="rgb(97 9 250)" stroke-width="2" />
        <circle cx="18.3" cy="23.4" r="1.6" fill="#fff" opacity="0.8" />
        <rect x="14" y="43.5" width="12" height="4" rx="1.5" fill="rgb(97 9 250)" />
      </svg>
    </div>
  </div>

  <ol>
    {passi.map((p, i) => (
      <li class="passo" data-passo>
        <div class="segno">
          <span class="numero">{pad(i + 1)}</span>
          {p.etichetta && <span class="etichetta">{p.etichetta}</span>}
        </div>
        <span class="nodo" aria-hidden="true"><Icona nome={p.icona} size={18} /></span>
        <div class="card">
          {p.domanda && <p class="domanda">{p.domanda}</p>}
          <h3>{p.titolo}</h3>
          {p.testo && <p class="testo">{p.testo}</p>}
        </div>
      </li>
    ))}
  </ol>

  <div class="arrivo" aria-hidden="true" data-arrivo><span></span></div>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-percorso]')) {
    const passi = [...el.querySelectorAll<HTMLElement>('[data-passo]')];
    const riempimento = el.querySelector<HTMLElement>('[data-riempimento]')!;
    const navicella = el.querySelector<HTMLElement>('[data-navicella]')!;
    const scafo = el.querySelector<HTMLElement>('[data-scafo]')!;
    const arrivo = el.querySelector<HTMLElement>('[data-arrivo]')!;
    const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (calmo) {
      el.classList.add('fermo');
      passi.forEach((p) => p.classList.add('visibile', 'raggiunto'));
      arrivo.classList.add('raggiunto');
      continue;
    }

    const io = new IntersectionObserver(
      (voci) => {
        for (const v of voci) {
          if (v.isIntersecting) {
            v.target.classList.add('visibile');
            io.unobserve(v.target);
          }
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    passi.forEach((p) => io.observe(p));

    let ultimaY = scrollY;
    let inCoda = false;
    function aggiorna() {
      inCoda = false;
      // Direzione: la navicella si gira solo dopo qualche pixel, così non trema.
      const dy = scrollY - ultimaY;
      if (Math.abs(dy) > 4) {
        scafo.classList.toggle('su', dy < 0);
        ultimaY = scrollY;
      }

      const r = el.getBoundingClientRect();
      const punta = innerHeight * 0.55;
      const avanzamento = Math.min(1, Math.max(0, (punta - r.top) / r.height));
      const y = avanzamento * r.height;
      riempimento.style.transform = `scaleY(${avanzamento})`;
      navicella.style.transform = `translate3d(0, ${y}px, 0)`;
      el.classList.toggle('in-volo', avanzamento > 0 && avanzamento < 1);

      // Una fase è raggiunta quando la navicella arriva al suo nodo; l'ultima raggiunta è quella attiva.
      let attivo: HTMLElement | undefined;
      for (const p of passi) {
        const nodo = p.querySelector<HTMLElement>('.nodo')!.getBoundingClientRect();
        const raggiunto = nodo.top + nodo.height / 2 - r.top <= y + 2;
        p.classList.toggle('raggiunto', raggiunto);
        if (raggiunto) attivo = p;
      }
      passi.forEach((p) => p.classList.toggle('attivo', p === attivo));
      arrivo.classList.toggle('raggiunto', avanzamento >= 0.995);
    }
    const pianifica = () => {
      if (!inCoda) {
        inCoda = true;
        requestAnimationFrame(aggiorna);
      }
    };
    addEventListener('scroll', pianifica, { passive: true });
    addEventListener('resize', pianifica);
    aggiorna();
  }
</script>

<style>
  .percorso { --x: 1.6rem; position: relative; max-width: 64rem; margin: 0 auto; padding-bottom: 3.5rem; }
  @media (min-width: 48rem) { .percorso { --x: 13rem; } }

  .linea { position: absolute; top: 0; bottom: 0; left: var(--x); width: 2px; margin-left: -1px; background: var(--border); border-radius: 2px; overflow: hidden; }
  .linea span { position: absolute; inset: 0; background: linear-gradient(var(--accent-btn), var(--accent-light)); transform: scaleY(0); transform-origin: top; }
  .fermo .linea span { transform: none; }

  /* ---------- Navicella ---------- */
  .navicella { position: absolute; z-index: 3; top: 0; left: var(--x); width: 0; height: 0; will-change: transform; pointer-events: none; }
  .fermo .navicella { top: 100%; }
  .scafo {
    position: absolute;
    left: -21px;
    top: -38px;
    width: 42px;
    height: 76px;
    transform: rotate(180deg); /* scende: punta verso il basso */
    transition: transform 0.6s cubic-bezier(.3, 1.4, .5, 1);
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--accent-light) 70%, transparent));
  }
  .scafo.su { transform: rotate(0deg); }
  .scafo svg { display: block; overflow: visible; animation: dondola 3s ease-in-out infinite; }
  .fiamma { transform-origin: 20px 47px; transform: scaleY(0.35); opacity: 0.5; transition: transform 0.3s, opacity 0.3s; }
  .in-volo .fiamma { animation: fiamma 0.12s ease-in-out infinite alternate; opacity: 1; }
  .fermo .fiamma { opacity: 0; }
  @keyframes fiamma { from { transform: scaleY(0.8) scaleX(0.9); } to { transform: scaleY(1.15) scaleX(1.05); } }
  @keyframes dondola { 0%, 100% { transform: translateX(-1px) rotate(-2deg); } 50% { transform: translateX(1px) rotate(2deg); } }

  /* ---------- Fasi ---------- */
  ol { list-style: none; margin: 0; padding: 4.5rem 0 0; display: grid; gap: 3.5rem; }
  .passo {
    position: relative;
    display: grid;
    grid-template-columns: calc(var(--x) * 2 + 0.5rem) 1fr;
    align-items: start;
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 0.6s ease, transform 0.7s cubic-bezier(.2, .8, .2, 1);
  }
  .passo.visibile { opacity: 1; transform: none; }

  .segno { grid-column: 2; display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.9rem; font-family: var(--mono); }
  .numero { font-size: var(--fs-sm); color: var(--muted); transition: color 0.3s; }
  .etichetta { font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); transition: color 0.3s; }
  .raggiunto .numero, .raggiunto .etichetta { color: var(--accent); }

  .nodo {
    position: absolute;
    left: var(--x);
    top: 0.1rem;
    translate: -50% 0;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--muted);
    transition: background-color 0.35s, border-color 0.35s, color 0.35s, box-shadow 0.35s, scale 0.4s cubic-bezier(.3, 1.6, .5, 1);
  }
  .raggiunto .nodo { background: var(--accent-btn); border-color: var(--accent-btn); color: var(--white); }
  .attivo .nodo { scale: 1.12; box-shadow: 0 0 0 6px var(--accent-soft), 0 0 28px color-mix(in srgb, var(--accent-light) 45%, transparent); }

  .card { grid-column: 2; padding: 1.5rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); transition: border-color 0.35s; }
  .attivo .card { border-color: var(--accent-border); }
  .card > * { margin: 0; }
  .domanda { font-family: var(--mono); font-size: var(--fs-sm); color: var(--accent); margin-bottom: 0.6rem; }
  h3 { font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.2; }
  .testo { margin-top: 0.75rem; color: var(--text-soft); line-height: 1.7; }

  @media (min-width: 48rem) {
    .passo { grid-template-columns: calc(var(--x) - 3rem) 6rem 1fr; }
    .segno { grid-column: 1; grid-row: 1; flex-direction: column; align-items: flex-end; gap: 0.35rem; margin: 0.2rem 0 0; text-align: right; }
    .numero { font-family: var(--font-display); font-size: 2.75rem; line-height: 1; letter-spacing: 0.02em; }
    .raggiunto .numero { color: var(--text); }
    .card { grid-column: 3; grid-row: 1; padding: 1.75rem 2rem; }
  }
  @media (max-width: 47.99rem) {
    .passo { padding-left: 0; }
    .card { padding: 1.25rem; }
  }

  /* ---------- Pianeta d'arrivo ---------- */
  .arrivo { position: absolute; left: var(--x); bottom: 0; translate: -50% 50%; width: 1.4rem; height: 1.4rem; }
  .arrivo span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--accent-glow), var(--accent-btn) 70%);
    box-shadow: 0 0 0 4px var(--bg);
    transition: box-shadow 0.5s, scale 0.5s cubic-bezier(.3, 1.6, .5, 1);
  }
  .arrivo::after { content: ''; position: absolute; inset: 50% -55%; height: 3px; translate: 0 -50%; rotate: -18deg; border-radius: 50%; border: 1px solid var(--accent-border); }
  .arrivo.raggiunto span { scale: 1.25; box-shadow: 0 0 0 4px var(--bg), 0 0 30px var(--accent-light); }

  @media (prefers-reduced-motion: reduce) {
    .passo { opacity: 1; transform: none; transition: none; }
    .scafo svg { animation: none; }
  }
</style>
