  .domanda { font-family: var(--mono); font-size: var(--fs-sm); color: var(--accent); margin-bottom: 0.5rem !important; }
  h3 { font-size: clamp(1.2rem, 2vw, 1.45rem); line-height: 1.2; }
  .testo { margin-top: 0.7rem !important; color: var(--text-soft); line-height: 1.65; }

  /* Desktop: due colonne, ogni box parte a metà del precedente (zig-zag compatto) */
  @media (min-width: 48rem) {
    .percorso { padding: 3.5rem 0 5rem; }
    ol { grid-template-columns: 1fr 1fr; column-gap: 4rem; row-gap: 1.5rem; grid-auto-rows: auto; }
