  .scia span:nth-child(5) { --d: 3px; --o: 0.3; }
  .scia span:nth-child(6) { --d: 2px; --o: 0.2; }

  /* ---------- Fasi: box ravvicinati, sfalsati a zig-zag ---------- */
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.25rem; }
  .passo { position: relative; z-index: 1; display: flex; }
