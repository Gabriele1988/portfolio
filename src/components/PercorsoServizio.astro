  }

  /* ---------- Pianeta d'arrivo ---------- */
  .arrivo { position: absolute; left: 50%; bottom: 0; z-index: 2; translate: -50% 35%; width: 4.75rem; height: 4.75rem; }
  @media (min-width: 48rem) { .arrivo { width: 6rem; height: 6rem; } }
  .arrivo svg { display: block; width: 100%; height: 100%; overflow: visible; opacity: 0.6; transition: opacity 0.5s, scale 0.6s cubic-bezier(.3, 1.6, .5, 1); }
  .arrivo.raggiunto svg { opacity: 1; scale: 1.12; filter: drop-shadow(0 0 18px color-mix(in srgb, var(--accent-light) 50%, transparent)); }

  @media (prefers-reduced-motion: reduce) {
    .card { opacity: 1; transform: none; transition: none; }
  }
</style>
