---
// Percorso di un servizio: un sentiero curvo che si snoda tra le fasi (a sinistra e a destra, alternate)
// e si riempie scorrendo. Una navicella viaggia sulla punta seguendo le curve: guarda dove sta andando,
// si gira quando risali, e le fasi che ha superato restano accese. In fondo c'è il pianeta d'arrivo.
// Il tracciato si ricalcola dalle posizioni reali delle card (anche quando cambiano larghezza o testi).
// Con "riduci movimento" il sentiero è pieno e la navicella è ferma all'arrivo.
import Icona from './Icona.astro';
import type { Passo } from '../lib/pagineServizi';

interface Props {
  passi: Passo[];
}
const { passi } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="percorso" data-percorso>
  <svg class="tracciato" aria-hidden="true" data-tracciato>
    <defs>
      <linearGradient id="pc-scia" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1000" data-scia>
        <stop offset="0" stop-color="rgb(97 9 250)" />
        <stop offset="1" stop-color="rgb(229 0 255)" />
      </linearGradient>
    </defs>
    <path class="base" data-base />
    <path class="pieno" data-pieno />
  </svg>

  <div class="navicella" aria-hidden="true" data-navicella>
    <div class="scafo" data-scafo>
      <svg viewBox="0 0 40 72" width="42" height="76">
        <defs>
          <linearGradient id="nv-fiamma" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#fff" />
            <stop offset="0.35" stop-color="rgb(240 138 255)" />
            <stop offset="1" stop-color="rgb(97 9 250)" stop-opacity="0" />
          </linearGradient>
          <linearGradient id="nv-corpo" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="#fff" />
            <stop offset="1" stop-color="#d9ccff" />
          </linearGradient>
        </defs>
        <path class="fiamma" d="M13.5 47 Q20 74 26.5 47Z" fill="url(#nv-fiamma)" />
        <path d="M11 30 L3 44 Q3 47 6 46 L11 43Z M29 30 L37 44 Q37 47 34 46 L29 43Z" fill="rgb(97 9 250)" />
        <path d="M20 2 C29 10 31.5 22 30 44 L10 44 C8.5 22 11 10 20 2Z" fill="url(#nv-corpo)" />
        <path d="M20 2 C24.5 6 27 10 28.3 15 L11.7 15 C13 10 15.5 6 20 2Z" fill="rgb(229 0 255)" />
        <circle cx="20" cy="25" r="5.2" fill="rgb(80 0 244)" stroke="rgb(97 9 250)" stroke-width="2" />
        <circle cx="18.3" cy="23.4" r="1.6" fill="#fff" opacity="0.8" />
        <rect x="14" y="43.5" width="12" height="4" rx="1.5" fill="rgb(97 9 250)" />
      </svg>
    </div>
  </div>

  <ol>
    {passi.map((p, i) => (
      <li class:list={['passo', i % 2 ? 'destra' : 'sinistra']} style={`--y: ${[50, 34, 62, 42, 58, 38][i % 6]}%; --xn: ${(i % 2 ? [30, 22, 34] : [70, 78, 66])[Math.floor(i / 2) % 3]}%`} data-passo>
        <span class="nodo" aria-hidden="true" data-nodo><Icona nome={p.icona} size={18} /></span>
        <div class="card" data-card>
          <p class="segno">
            <span class="numero">{pad(i + 1)}</span>
            {p.etichetta && <span class="etichetta">{p.etichetta}</span>}
          </p>
          {p.domanda && <p class="domanda">{p.domanda}</p>}
          <h3>{p.titolo}</h3>
          {p.testo && <p class="testo">{p.testo}</p>}
        </div>
      </li>
    ))}
  </ol>

  <div class="arrivo" aria-hidden="true" data-arrivo><span></span></div>
</div>

<script>
  type Punto = { x: number; y: number };
  const desktop = matchMedia('(min-width: 48rem)');

  for (const el of document.querySelectorAll<HTMLElement>('[data-percorso]')) {
    const svg = el.querySelector<SVGSVGElement>('[data-tracciato]')!;
    const base = el.querySelector<SVGPathElement>('[data-base]')!;
    const pieno = el.querySelector<SVGPathElement>('[data-pieno]')!;
    const scia = el.querySelector<SVGLinearGradientElement>('[data-scia]')!;
    const navicella = el.querySelector<HTMLElement>('[data-navicella]')!;
    const scafo = el.querySelector<HTMLElement>('[data-scafo]')!;
    const arrivo = el.querySelector<HTMLElement>('[data-arrivo]')!;
    const passi = [...el.querySelectorAll<HTMLElement>('[data-passo]')];
    const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Campioni del tracciato (x, y, lunghezza) per trovare in fretta il punto all'altezza dello schermo.
    let lunghezza = 0;
    let cx: number[] = [];
    let cy: number[] = [];
    let cl: number[] = [];
    let lunghezzaNodi: number[] = [];


    function indiceA(y: number) {
      let lo = 0;
      let hi = cy.length - 1;
      while (lo < hi) {
        const m = (lo + hi) >> 1;
        if (cy[m] < y) lo = m + 1;
        else hi = m;
      }
      return lo;
    }

    function disegna() {
      const W = el.clientWidth;
      const H = el.clientHeight;
      if (!W || !H) return;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      scia.setAttribute('y2', String(H));

      type Tratto = [Punto, Punto, Punto, Punto];
      const card: DOMRect[] = [];
      const nodi: Punto[] = [];
      for (const li of passi) {
        const c = li.querySelector<HTMLElement>('[data-card]')!;
        const nodo = li.querySelector<HTMLElement>('[data-nodo]')!;
        card.push(new DOMRect(li.offsetLeft + c.offsetLeft, li.offsetTop + c.offsetTop, c.offsetWidth, c.offsetHeight));
        nodi.push({ x: li.offsetLeft + nodo.offsetLeft + nodo.offsetWidth / 2, y: li.offsetTop + nodo.offsetTop + nodo.offsetHeight / 2 });
      }
      const margine = 14;
      const libero = (tt: Tratto[]) =>
        tt.every(([p0, p1, p2, p3]) => {
          for (let t = 0.02; t < 1; t += 0.02) {
            const u = 1 - t;
            const x = u * u * u * p0.x + 3 * u * u * t * p1.x + 3 * u * t * t * p2.x + t * t * t * p3.x;
            const y = u * u * u * p0.y + 3 * u * u * t * p1.y + 3 * u * t * t * p2.y + t * t * t * p3.y;
            if (card.some((r) => x > r.left - margine && x < r.right + margine && y > r.top - margine && y < r.bottom + margine)) return false;
          }
          return true;
        });

      // Desktop: una curva continua (spline) passa da un nodo all'altro, senza pieghe.
      // Dove passerebbe sopra una card, la curva si "tende" un po' in quel punto finché non la tocca più.
      const punti: Punto[] = [];
      punti.push({ x: W / 2, y: 0 }, ...nodi, { x: W / 2, y: H });
      const morbidezza = punti.map(() => 1);
      const costruisci = () =>
        punti.slice(0, -1).map((p, i): Tratto => {
          const q = punti[i + 1];
          const tangente = (k: number) => {
            const prima = punti[Math.max(0, k - 1)];
            const dopo = punti[Math.min(punti.length - 1, k + 1)];
            return { x: ((dopo.x - prima.x) / 5) * morbidezza[k], y: (dopo.y - prima.y) / 3.2 };
          };
          const tp = tangente(i);
          const tq = tangente(i + 1);
          return [p, { x: p.x + tp.x, y: p.y + tp.y }, { x: q.x - tq.x, y: q.y - tq.y }, q];
        });
      let tratti = costruisci();
      if (desktop.matches) {
        for (let giro = 0; giro < 8; giro++) {
          let ok = true;
          tratti.forEach((t, i) => {
            if (!libero([t])) {
              ok = false;
              morbidezza[i] *= 0.6;
              morbidezza[i + 1] *= 0.6;
            }
          });
          if (ok) break;
          tratti = costruisci();
        }
      } else {
        // Telefono: il sentiero scende nella striscia accanto alla card e cambia lato tra una card e l'altra
        // con una lunga curva a S (verticale alle estremità, quindi senza pieghe).
        const s = (a: Punto, b: Punto): Tratto => {
          const k = (b.y - a.y) * 0.5;
          return [a, { x: a.x, y: a.y + k }, { x: b.x, y: b.y - k }, b];
        };
        tratti = [];
        let da: Punto = { x: nodi[0]?.x ?? W / 2, y: 0 };
        nodi.forEach((n, i) => {
          const a = { x: n.x, y: card[i].top };
          const b = { x: n.x, y: card[i].bottom };
          tratti.push(s(da, a), s(a, n), s(n, b));
          da = b;
        });
        tratti.push(s(da, { x: da.x, y: H }));
      }
      const fine = tratti[tratti.length - 1][3];
      arrivo.style.left = `${fine.x}px`;
      let d = `M ${tratti[0][0].x} ${tratti[0][0].y}`;
      for (const [, c1, c2, p] of tratti) d += ` C ${c1.x} ${c1.y} ${c2.x} ${c2.y} ${p.x} ${p.y}`;
      base.setAttribute('d', d);
      pieno.setAttribute('d', d);

      lunghezza = pieno.getTotalLength();
      pieno.style.strokeDasharray = `${lunghezza} ${lunghezza}`;
      const passo = 3;
      cx = [];
      cy = [];
      cl = [];
      let maxY = -Infinity;
      for (let l = 0; l <= lunghezza; l += passo) {
        const p = pieno.getPointAtLength(l);
        maxY = Math.max(maxY, p.y); // y sempre crescente: la ricerca binaria resta valida
        cx.push(p.x);
        cy.push(maxY);
        cl.push(l);
      }
      lunghezzaNodi = nodi.map((n) => cl[indiceA(n.y)]);
    }

    let ultimaY = scrollY;
    let inCoda = false;
    function aggiorna() {
      inCoda = false;
      if (!cl.length) return;
      const dy = scrollY - ultimaY;
      if (Math.abs(dy) > 4) {
        scafo.classList.toggle('su', dy < 0);
        ultimaY = scrollY;
      }
      const r = el.getBoundingClientRect();
      const punta = calmo ? Infinity : innerHeight * 0.55 - r.top;
      const i = punta <= 0 ? 0 : Math.min(cl.length - 1, indiceA(punta));
      const l = cl[i];
      pieno.style.strokeDashoffset = String(lunghezza - l);

      // Direzione del tracciato in quel punto: la navicella punta lì.
      const i0 = Math.max(0, i - 2);
      const i1 = Math.min(cl.length - 1, i + 2);
      const angolo = (Math.atan2(cy[i1] - cy[i0], cx[i1] - cx[i0]) * 180) / Math.PI + 90;
      navicella.style.transform = `translate3d(${cx[i]}px, ${cy[i]}px, 0) rotate(${angolo}deg)`;
      el.classList.toggle('in-volo', i > 0 && i < cl.length - 1);

      let attivo: HTMLElement | undefined;
      passi.forEach((p, k) => {
        const raggiunto = lunghezzaNodi[k] <= l + 1;
        p.classList.toggle('raggiunto', raggiunto);
        if (raggiunto) attivo = p;
      });
      passi.forEach((p) => p.classList.toggle('attivo', p === attivo));
      arrivo.classList.toggle('raggiunto', i >= cl.length - 2);
    }
    const pianifica = () => {
      if (!inCoda) {
        inCoda = true;
        requestAnimationFrame(aggiorna);
      }
    };

    if (calmo) {
      el.classList.add('fermo');
      passi.forEach((p) => p.classList.add('visibile'));
    } else {
      const io = new IntersectionObserver(
        (voci) => {
          for (const v of voci) {
            if (v.isIntersecting) {
              v.target.classList.add('visibile');
              io.unobserve(v.target);
            }
          }
        },
        { rootMargin: '0px 0px -12% 0px' },
      );
      passi.forEach((p) => io.observe(p));
      addEventListener('scroll', pianifica, { passive: true });
    }
    new ResizeObserver(() => {
      disegna();
      aggiorna();
    }).observe(el);
  }
</script>

<style>
  .percorso { --striscia: 4.5rem; position: relative; max-width: 72rem; margin: 0 auto; padding-bottom: 2.5rem; }

  .tracciato { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .base, .pieno { fill: none; stroke-linecap: round; }
  .base { stroke: var(--border); stroke-width: 2; }
  .pieno { stroke: url(#pc-scia); stroke-width: 3; }

  /* ---------- Navicella ---------- */
  .navicella { position: absolute; z-index: 3; top: 0; left: 0; width: 0; height: 0; will-change: transform; pointer-events: none; }
  .scafo {
    position: absolute;
    left: -21px;
    top: -38px;
    width: 42px;
    height: 76px;
    transition: transform 0.6s cubic-bezier(.3, 1.4, .5, 1);
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--accent-light) 70%, transparent));
  }
  .scafo.su { transform: rotate(180deg); }
  .scafo svg { display: block; overflow: visible; animation: dondola 3s ease-in-out infinite; }
  .fiamma { transform-origin: 20px 47px; transform: scaleY(0.35); opacity: 0.5; transition: transform 0.3s, opacity 0.3s; }
  .in-volo .fiamma { animation: fiamma 0.12s ease-in-out infinite alternate; opacity: 1; }
  .fermo .fiamma { opacity: 0; }
  @keyframes fiamma { from { transform: scaleY(0.8) scaleX(0.9); } to { transform: scaleY(1.15) scaleX(1.05); } }
  @keyframes dondola { 0%, 100% { transform: translateX(-1px) rotate(-2deg); } 50% { transform: translateX(1px) rotate(2deg); } }

  /* ---------- Fasi: card alternate, il sentiero passa nello spazio libero accanto ---------- */
  ol { list-style: none; margin: 0; padding: 2.5rem 0 0; display: grid; gap: 8rem; }
  .passo { position: relative; display: flex; }
  .destra { justify-content: flex-end; }
  .card {
    position: relative;
    z-index: 1;
    width: calc(100% - var(--striscia));
    padding: 1.25rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    opacity: 0;
    transform: translateX(-1.5rem);
    transition: border-color 0.35s, opacity 0.6s ease, transform 0.7s cubic-bezier(.2, .8, .2, 1);
  }
  .destra .card { transform: translateX(1.5rem); }
  .visibile .card { opacity: 1; transform: none; }
  .attivo .card { border-color: var(--accent-border); }
  .card > * { margin: 0; }

  .segno { display: flex; align-items: baseline; gap: 0.75rem; margin-bottom: 0.75rem !important; font-family: var(--mono); }
  .numero { font-size: var(--fs-sm); color: var(--muted); transition: color 0.3s; }
  .etichetta { font-size: var(--fs-xs); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); transition: color 0.3s; }
  .raggiunto .numero, .raggiunto .etichetta { color: var(--accent); }
  .domanda { font-family: var(--mono); font-size: var(--fs-sm); color: var(--accent); margin-bottom: 0.6rem !important; }
  h3 { font-size: clamp(1.25rem, 2.2vw, 1.6rem); line-height: 1.2; }
  .testo { margin-top: 0.75rem !important; color: var(--text-soft); line-height: 1.7; }

  .nodo {
    position: absolute;
    z-index: 2;
    top: var(--y, 50%);
    left: calc(100% - var(--striscia) / 2);
    width: 2.6rem;
    height: 2.6rem;
    margin: -1.3rem 0 0 -1.3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--muted);
    transition: background-color 0.35s, border-color 0.35s, color 0.35s, box-shadow 0.35s, scale 0.4s cubic-bezier(.3, 1.6, .5, 1);
  }
  .destra .nodo { left: calc(var(--striscia) / 2); }
  .raggiunto .nodo { background: var(--accent-btn); border-color: var(--accent-btn); color: var(--white); }
  .attivo .nodo { scale: 1.12; box-shadow: 0 0 0 6px var(--accent-soft), 0 0 28px color-mix(in srgb, var(--accent-light) 45%, transparent); }

  @media (min-width: 48rem) {
    ol { padding-top: 3rem; gap: 9rem; }
    .card { width: 46%; padding: 1.75rem 2rem; }
    .sinistra .nodo, .destra .nodo { left: var(--xn); }
    .numero { font-family: var(--font-display); font-size: 2rem; line-height: 1; letter-spacing: 0.02em; }
    .raggiunto .numero { color: var(--text); }
    .segno { gap: 1rem; margin-bottom: 1rem !important; }
  }

  /* ---------- Pianeta d'arrivo ---------- */
  .arrivo { position: absolute; left: 50%; bottom: 0; translate: -50% 50%; width: 1.4rem; height: 1.4rem; }
  .arrivo span {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, var(--accent-glow), var(--accent-btn) 70%);
    box-shadow: 0 0 0 4px var(--bg);
    transition: box-shadow 0.5s, scale 0.5s cubic-bezier(.3, 1.6, .5, 1);
  }
  .arrivo::after { content: ''; position: absolute; inset: 50% -55%; height: 3px; translate: 0 -50%; rotate: -18deg; border-radius: 50%; border: 1px solid var(--accent-border); }
  .arrivo.raggiunto span { scale: 1.25; box-shadow: 0 0 0 4px var(--bg), 0 0 30px var(--accent-light); }

  @media (prefers-reduced-motion: reduce) {
    .card { opacity: 1; transform: none; transition: none; }
    .scafo svg { animation: none; }
  }
</style>
