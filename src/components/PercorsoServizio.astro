f0ff" d="m19 55h2v2h-2z"/><path fill="#f4f0ff" d="m37 58h2v2h-2z"/></g></svg>
  </div>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-percorso]')) {
    const svg = el.querySelector<SVGSVGElement>('[data-tracciato]')!;
    const base = el.querySelector<SVGPathElement>('[data-base]')!;
    const alone = el.querySelector<SVGPathElement>('[data-alone]')!;
    const pieno = el.querySelector<SVGPathElement>('[data-pieno]')!;
    const gradiente = el.querySelector<SVGLinearGradientElement>('[data-scia]')!;
    const navicella = el.querySelector<HTMLElement>('[data-navicella]')!;
    const scafo = el.querySelector<HTMLElement>('[data-scafo]')!;
    const scia = [...el.querySelectorAll<HTMLElement>('[data-scia-punti] span')];
    const arrivo = el.querySelector<HTMLElement>('[data-arrivo]')!;
    const passi = [...el.querySelectorAll<HTMLElement>('[data-passo]')];
    const card = passi.map((p) => p.querySelector<HTMLElement>('.card')!);
    const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Campioni del tracciato (x, y, lunghezza) per trovare in fretta il punto all'altezza dello schermo.
    let lunghezza = 0;
    let cx: number[] = [];
    let cy: number[] = [];
    let cl: number[] = [];
    let box: DOMRect[] = [];

    function indiceA(y: number) {
      let lo = 0;
      let hi = cy.length - 1;
      while (lo < hi) {
        const m = (lo + hi) >> 1;
        if (cy[m] < y) lo = m + 1;
        else hi = m;
      }
      return lo;
    }

    function disegna() {
      const W = el.clientWidth;
      const H = el.clientHeight;
      if (!W || !H) return;
      svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
      gradiente.setAttribute('y2', String(H));

      // Il sentiero attraversa il centro di ogni box (passandoci sotto), da metà in alto a metà in fondo.
      box = passi.map((li, i) => new DOMRect(li.offsetLeft + card[i].offsetLeft, li.offsetTop + card[i].offsetTop, card[i].offsetWidth, card[i].offsetHeight));
      const punti = [{ x: W / 2, y: 0 }, ...box.map((r) => ({ x: r.left + r.width / 2, y: r.top + r.height / 2 })), { x: W / 2, y: H }];
      // Curva di Catmull-Rom: passa da tutti i punti senza spigoli. Le tangenti verticali restano ampie (curve morbide).
      let d = `M ${punti[0].x} ${punti[0].y}`;
      for (let i = 0; i < punti.length - 1; i++) {
        const a = punti[Math.max(0, i - 1)];
        const p = punti[i];
        const q = punti[i + 1];
        const b = punti[Math.min(punti.length - 1, i + 2)];
        const c1 = { x: p.x + (q.x - a.x) / 6, y: p.y + Math.max(0, q.y - a.y) / 4 };
        const c2 = { x: q.x - (b.x - p.x) / 6, y: q.y - Math.max(0, b.y - p.y) / 4 };
        d += ` C ${c1.x} ${c1.y} ${c2.x} ${c2.y} ${q.x} ${q.y}`;
      }
      for (const path of [base, alone, pieno]) path.setAttribute('d', d);

      lunghezza = pieno.getTotalLength();
      for (const path of [alone, pieno]) path.style.strokeDasharray = `${lunghezza} ${lunghezza}`;
      cx = [];
      cy = [];
      cl = [];
      let maxY = -Infinity;
      for (let l = 0; l <= lunghezza; l += 3) {
        const pt = pieno.getPointAtLength(l);
        maxY = Math.max(maxY, pt.y); // y sempre crescente: la ricerca binaria resta valida
        cx.push(pt.x);
        cy.push(maxY);
        cl.push(l);
      }
    }

    let ultimaY = scrollY;
    let inCoda = false;
    function aggiorna() {
      inCoda = false;
      if (!cl.length) return;
      const dy = scrollY - ultimaY;
      if (Math.abs(dy) > 4) {
        scafo.classList.toggle('su', dy < 0);
        ultimaY = scrollY;
      }
      const r = el.getBoundingClientRect();
      const punta = calmo ? Infinity : innerHeight * 0.55 - r.top;
      const i = punta <= 0 ? 0 : Math.min(cl.length - 1, indiceA(punta));
      const l = cl[i];
      for (const path of [alone, pieno]) path.style.strokeDashoffset = String(lunghezza - l);

      // Il razzo punta nella direzione del sentiero (nel disegno guarda a 45° in alto a destra).
      const i0 = Math.max(0, i - 2);
      const i1 = Math.min(cl.length - 1, i + 2);
      const angolo = (Math.atan2(cy[i1] - cy[i0], cx[i1] - cx[i0]) * 180) / Math.PI + 45;
      const x = cx[i];
      const y = cy[i];
      navicella.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${angolo.toFixed(1)}deg)`;
      // Scia: scintille sempre più piccole e trasparenti nei punti appena percorsi.
      scia.forEach((s, k) => {
        const j = Math.max(0, i - (k + 1) * 5);
        s.style.transform = `translate3d(${cx[j]}px, ${cy[j]}px, 0)`;
      });
      const inVolo = i > 0 && i < cl.length - 1;
      el.classList.toggle('in-volo', inVolo);

      // Box: luce che segue il razzo quando ci passa sotto; acceso quando il razzo ne ha raggiunto il centro.
      let sotto = -1;
      box.forEach((b, k) => {
        const dentro = x > b.left - 40 && x < b.right + 40 && y > b.top - 40 && y < b.bottom + 40;
        const c = card[k];
        if (dentro) {
          sotto = k;
          c.style.setProperty('--mx', `${x - b.left}px`);
          c.style.setProperty('--my', `${y - b.top}px`);
        }
        c.classList.toggle('illuminato', dentro && inVolo);
        passi[k].classList.toggle('raggiunto', y >= b.top + b.height / 2 - 1);
      });
      navicella.classList.toggle('sotto-box', sotto >= 0 && inVolo);
      arrivo.classList.toggle('raggiunto', i >= cl.length - 2);
    }
    const pianifica = () => {
      if (!inCoda) {
        inCoda = true;
        requestAnimationFrame(aggiorna);
      }
    };

    if (calmo) {
      el.classList.add('fermo');
      passi.forEach((p) => p.classList.add('visibile'));
    } else {
      const io = new IntersectionObserver(
        (voci) => {
          for (const v of voci) {
            if (v.isIntersecting) {
              v.target.classList.add('visibile');
              io.unobserve(v.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      passi.forEach((p) => io.observe(p));
      addEventListener('scroll', pianifica, { passive: true });
    }
    new ResizeObserver(() => {
      disegna();
      aggiorna();
    }).observe(el);
  }
</script>

<style>
  .percorso { position: relative; max-width: 72rem; margin: 0 auto; padding: 3rem 0 4rem; }

