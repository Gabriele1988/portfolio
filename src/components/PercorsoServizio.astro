---
// Percorso di un servizio: un sentiero curvo che si snoda tra le fasi (a sinistra e a destra, alternate)
// e si riempie scorrendo. Un razzo viaggia sulla punta seguendo le curve (punta dove va, si gira quando risali)
// e le fasi che ha superato restano accese. In fondo c'è il pianeta d'arrivo.
// Il tracciato si ricalcola dalle posizioni reali delle card (anche quando cambiano larghezza o testi).
// Con "riduci movimento" il sentiero è pieno e il razzo è fermo all'arrivo.
import Icona from './Icona.astro';
import type { Passo } from '../lib/pagineServizi';

interface Props {
  passi: Passo[];
}
const { passi } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="percorso" data-percorso>
  <svg class="tracciato" aria-hidden="true" data-tracciato>
    <defs>
      <linearGradient id="pc-scia" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="1000" data-scia>
        <stop offset="0" stop-color="rgb(97 9 250)" />
        <stop offset="1" stop-color="rgb(229 0 255)" />
      </linearGradient>
    </defs>
    <path class="base" data-base />
    <path class="pieno" data-pieno />
  </svg>

  <div class="navicella" aria-hidden="true" data-navicella>
    <div class="scafo" data-scafo>
      <svg viewBox="0 0 512.001 512.001" width="64" height="64"><path style="fill:#FF5249;" d="M501.752,10.001c0,0-1.93,53.83-24.3,117.12l-92.82-92.82 C447.922,11.931,501.752,10.001,501.752,10.001z"/> <path style="fill:#FFFFFF;" d="M384.632,34.301l92.82,92.82c-14.54,41.18-37.75,86.36-74.69,123.3 c-34.041,34.041-74.993,61.29-117.81,80.18l-103.8-103.8c12.64-28.65,30.28-59.22,53.59-88.17c8.16-10.13,17.01-20.06,26.59-29.64 C298.272,72.051,343.452,48.841,384.632,34.301z"/> <path style="fill:#7BD8E8;" d="M388.612,123.141c15.62,15.62,15.62,40.95,0,56.57s-40.94,15.62-56.57,0 c-15.62-15.63-15.62-40.95,0-56.57S372.992,107.521,388.612,123.141z"/> <g> <path style="fill:#FF5249;" d="M374.472,278.701c51.54,77.31-44.94,127.28-98.99,127.28c28.28-28.28,20.02-64.83,20.02-64.83 l-10.55-10.55c28.65-12.64,59.22-30.28,88.17-53.59L374.472,278.701z"/> <path style="fill:#FF5249;" d="M169.532,300.041l-1.62-1.62c-4.78-4.79-7.13-11.73-5.45-18.29c4.17-16.24,10.33-34.36,18.69-53.33 l103.8,103.8c-18.97,8.36-37.09,14.52-53.33,18.69c-6.56,1.68-13.5-0.67-18.29-5.45l-1.62-1.62L169.532,300.041z"/> <path style="fill:#FF5249;" d="M233.052,137.281l1.69,1.35c-23.31,28.95-40.95,59.52-53.59,88.17l-10.55-10.55 c0,0-36.55-8.26-64.83,20.02C105.772,182.221,155.742,85.741,233.052,137.281z"/> </g> <path style="fill:#FFDD78;" d="M169.532,300.041l42.18,42.18c-3.03,11.99-10.22,24.61-21.09,35.48 c-23.43,23.43-84.85,28.28-84.85,28.28s4.85-61.42,28.28-84.85C144.922,310.261,157.542,303.071,169.532,300.041z"/> <path fill="#f4f0ff" d="M268.662,257.491c3.9-3.91,3.9-10.24,0-14.14c-3.91-3.91-10.24-3.91-14.15,0c-3.9,3.9-3.9,10.23,0,14.14 C258.422,261.391,264.752,261.391,268.662,257.491z"/> <path fill="#f4f0ff" d="M395.933,186.782c19.538-19.538,19.542-51.171,0-70.712c-19.54-19.539-51.172-19.54-70.713,0 c-19.489,19.489-19.49,51.209,0.003,70.714C344.719,206.268,376.439,206.276,395.933,186.782z M339.363,130.212 c11.723-11.723,30.703-11.725,42.428,0c11.723,11.722,11.725,30.703,0,42.427c-11.693,11.694-30.727,11.694-42.426,0.002 C32