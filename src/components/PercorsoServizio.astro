    </div>
  </div>

  <ol>
    {passi.map((p, i) => (
      <li class:list={['passo', i % 2 ? 'destra' : 'sinistra']} style={`--r: ${i + 1}`} data-passo>
        <div class="card">
          <p class="segno">
            <span class="numero">{pad(i + 1)}</span>
            <span class="ico" aria-hidden="true"><Icona nome={p.icona} size={18} /></span>
            {p.etichetta && <span class="etichetta">{p.etichetta}</span>}
          </p>
          {p.domanda && <p class="domanda">{p.domanda}</p>}
          <h3>{p.titolo}</h3>
          {p.testo && <p class="testo">{p.testo}</p>}
        </div>
      </li>
    ))}
  </ol>

  <div class="arrivo" aria-hidden="true" data-arrivo>
    <svg viewBox="0 0 64 64" width="96" height="96"><g><circle cx="52" cy="54" fill="#50b4f8" r="7"/><circle cx="11.054" cy="8" fill="#f9bb4b" r="5"/><circle cx="32" cy="31" fill="#9362f5" r="19"/><path fill="#f4f0ff" d="m52 47a6.984 6.984 0 0 0 -6.823 8.546l3.823-.546 1-3 3-1 3 2 2.487-1.625a7 7 0 0 0 -6.487-4.375z" fill="#c8d952"/><path fill="#f4f0ff" d="m55 56-2-1-1 3-3.547 2.027a6.984 6.984 0 0 0 10.021-3.369z" fill="#c8d952"/><path fill="#f4f0ff" d="m13.01 30.8c6.99-1.8 10.928-2.8 18.99-2.8 4 0 3-3 7-5 3.709-1.854 6.68-1.049 8.769-2.6a19.09 19.09 0 0 0 -4.651-4.785c-2.697 1.794-6.146 3.385-9.118 3.385-5 0-4 5-8 5-6 0-9.216 2.173-12.474 2.628a18.962 18.962 0 0 0 -.516 4.172z" fill="#d0bafa"/><path fill="#f4f0ff" d="m32 33c-6.96 0-14.4 1.937-18.283 3.115a18.9 18.9 0 0 0 1.516 3.817c3.767-1.932 5.821.068 9.767.068 3 0 2-3 8-3 5.1 0 6 1 10-3 2.3-2.3 5.59-2.614 7.973-2.467.005-.179.027-.353.027-.533a18.985 18.985 0 0 0 -.607-4.689 20.029 20.029 0 0 1 -5.393.689c-7 0-3 6-13 6z" fill="#d0bafa"/><path fill="#f4f0ff" d="m5.081 8.547a5.994 5.994 0 0 0 9.338 4.417 8.688 8.688 0 0 0 2.611.539 2.378 2.378 0 0 0 .938-.166 1.7 1.7 0 0 0 1.011-.958c.656-1.6-.489-2.827-1.949-3.9.012-.157.024-.314.024-.474a5.991 5.991 0 0 0 -10.374-4.099c-2.773-.549-4.12-.339-4.552.716-.582 1.423.649 2.593 2.953 3.925zm11.379 2.037c.424.375.67.683.687.9a3.848 3.848 0 0 1 -1.115-.141 5.9 5.9 0 0 0 .428-.759zm-5.406 1.416a3.989 3.989 0 0 1 -3.523-2.146c.492.25 1.006.507 1.544.775l.531.266c.815.407 1.526.736 2.188 1.03a4.019 4.019 0 0 1 -.74.075zm0-8a3.984 3.984 0 0 1 2.946 6.685c-.909-.353-2.055-.859-3.5-1.58l-.533-.266c-.9-.447-1.911-.956-2.852-1.458a4 4 0 0 1 3.939-3.381zm-5.554 1.726a6.089 6.089 0 0 0 -.212.614 7.059 7.059 0 0 1 -1.002-.74 9.525 9.525 0 0 1 1.214.126z"/><path fill="#f4f0ff" d="m44 54a8 8 0 1 0 8-8 8.009 8.009 0 0 0 -8 8zm8 6a6 6 0 0 1 -1.251-.133l1.747-1a1 1 0 0 0 .453-.552l.635-1.906.969.485a.99.99 0 0 0 .261.087l2.134.405a6 6 0 0 1 -4.948 2.614zm5.9-7.049a5.741 5.741 0 0 1 -.