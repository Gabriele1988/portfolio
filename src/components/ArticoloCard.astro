---
// Card di un articolo del blog: immagine 16:9, data e tempo di lettura, titolo, estratto.
import { Image } from 'astro:assets';
import Icona from './Icona.astro';
import { dataItaliana, type Articolo } from '../lib/blog';

interface Props {
  articolo: Articolo;
  eager?: boolean;
  sizes?: string;
  /** Livello del titolo (h2 nella lista, h3 sotto un altro h2). */
  livello?: 'h2' | 'h3';
}
const { articolo: a, eager = false, sizes = '(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw', livello = 'h2' } = Astro.props;
const Titolo = livello;
---

<article class="card">
  <div class="media">
    {a.copertina ? (
      <Image
        src={a.copertina.src}
        alt={a.copertina.alt || a.titolo}
        width={a.copertina.width ?? 1344}
        height={a.copertina.height ?? 768}
        widths={[400, 640, 800, 1200]}
        sizes={sizes}
        loading={eager ? 'eager' : 'lazy'}
        fetchpriority={eager ? 'high' : undefined}
      />
    ) : (
      <div class="vuoto" aria-hidden="true"><Icona nome="sparkles" size={26} /></div>
    )}
  </div>
  <p class="meta"><time datetime={a.data}>{dataItaliana(a.data)}</time><span aria-hidden="true">·</span>{a.minuti} min di lettura</p>
  <Titolo class="titolo"><a class="copri" href={`/blog/${a.slug}/`}>{a.titolo}</a></Titolo>
  {a.estratto && <p class="estratto">{a.estratto}</p>}
  <p class="leggi" aria-hidden="true">Leggi l’articolo <Icona nome="arrowRight" size={14} /></p>
</article>

<style>
  .card { position: relative; display: flex; flex-direction: column; gap: 0.75rem; padding: 1rem 1rem 1.5rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); transition: border-color 0.25s, transform 0.25s; }
  .card:hover { border-color: var(--accent-border); transform: translateY(-3px); }
  .media { aspect-ratio: 16 / 9; border-radius: calc(var(--radius) * 0.7); overflow: hidden; background: var(--accent-soft); margin-bottom: 0.5rem; }
  .media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .card:hover .media img { transform: scale(1.03); }
  .vuoto { display: grid; place-items: center; height: 100%; color: var(--accent-light); }
  .meta { display: flex; gap: 0.5rem; margin: 0 0.25rem; font-size: var(--fs-2xs); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .titolo { margin: 0 0.25rem; font-size: var(--fs-lg); line-height: 1.25; }
  .copri { color: inherit; text-decoration: none; }
  .copri::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .copri:focus-visible { outline: none; }
  .card:has(.copri:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .estratto { margin: 0 0.25rem; color: var(--muted); font-size: var(--fs-sm); line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .leggi { margin: auto 0.25rem 0; padding-top: 0.5rem; display: inline-flex; align-items: center; gap: 0.4rem; font-size: var(--fs-sm); color: var(--accent-light); }
</style>
