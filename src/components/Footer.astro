---
import { sito } from '../site.config';
const anno = new Date().getFullYear();
---

<footer class="wrap">
  <p>
    © {anno} {sito.nome} · {sito.citta} · <a href={`mailto:${sito.email}`}>{sito.email}</a>
    {sito.telefono && <>{' · '}<a href={`tel:${sito.telefono.replace(/\s/g, '')}`}>{sito.telefono}</a></>}
  </p>
  <p>
    {[
      sito.social.github && { href: sito.social.github, label: 'GitHub', rel: 'me' },
      sito.social.linkedin && { href: sito.social.linkedin, label: 'LinkedIn', rel: 'me' },
      { href: '/privacy/', label: 'Privacy' },
    ]
      .filter(Boolean)
      .map((l: any, i) => <>{i > 0 && ' · '}<a href={l.href} rel={l.rel}>{l.label}</a></>)}
  </p>
</footer>

<style>
  footer { padding-block: 3rem; border-top: 1px solid var(--border); margin-top: 4rem; color: var(--muted); font-size: var(--fs-md); }
  footer p { margin: 0.25rem 0; }
</style>
