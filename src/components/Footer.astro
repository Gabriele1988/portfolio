---
import { getTesti } from '../lib/testi';

const g = (await getTesti()).generale;
const anno = new Date().getFullYear();
---

<footer class="wrap">
  <p>
    © {anno} {g.nome} · {g.citta}
    {g.email && <>{' · '}<a href={`mailto:${g.email}`}>{g.email}</a></>}
    {g.telefono && <>{' · '}<a href={`tel:${g.telefono.replace(/\s/g, '')}`}>{g.telefono}</a></>}
  </p>
  <p>
    {[
      g.github && { href: g.github, label: 'GitHub', rel: 'me' },
      g.linkedin && { href: g.linkedin, label: 'LinkedIn', rel: 'me' },
      { href: '/privacy/', label: g.footer_privacy },
    ]
      .filter(Boolean)
      .map((l: any, i) => <>{i > 0 && ' · '}<a href={l.href} rel={l.rel}>{l.label}</a></>)}
  </p>
</footer>

<style>
  footer { padding-block: 3rem; border-top: 1px solid var(--border); margin-top: 4rem; color: var(--muted); font-size: var(--fs-md); }
  footer p { margin: 0.25rem 0; }
</style>
