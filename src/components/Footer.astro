---
// Footer: logo e descrizione con i social, navigazione, contatti e dati legali.
// Tutti i testi e i link arrivano da "Testi del sito → Generale".
import Logo from './Logo.astro';
import Icona from './Icona.astro';
import Social from './Social.astro';
import { getTesti } from '../lib/testi';
import { getPagineServizi } from '../lib/pagineServizi';
import { getArticoli } from '../lib/blog';
import { getVociMenu } from '../lib/menu';

const [testi, pagine, articoli] = await Promise.all([getTesti(), getPagineServizi(), getArticoli()]);
const g = testi.generale;
const anno = new Date().getFullYear();
const righe = (t: string) => t.split('\n').map((r) => r.trim()).filter(Boolean);
// Stesso ordine del menu in alto (senza Home, che è il logo), poi i link legali.
const voci = [
  ...(await getVociMenu(g, articoli.length > 0)).filter((v) => v.chiave !== 'home'),
  { href: '/privacy/', label: g.footer_privacy },
  { href: '/cookie-policy/', label: g.footer_cookie },
];
---

<footer>
  <div class="wrap">
    <div class="colonne">
      <div class="marca">
        <a class="logo" href="/"><Logo id="logo-footer" titolo={g.nome} /></a>
        {g.footer_descrizione && <p class="descrizione">{righe(g.footer_descrizione).map((r, i) => <>{i > 0 && <br />}{r}</>)}</p>}
        <Social g={g} />
      </div>

      <nav aria-label="Footer">
        <p class="titolo">{g.footer_titolo_nav}</p>
        <ul>
          {voci.map((v) => <li><a href={v.href}>{v.label}</a></li>)}
        </ul>
      </nav>

      {pagine.length > 0 && (
        <nav aria-label={g.menu_servizi}>
          <p class="titolo">{g.menu_servizi}</p>
          <ul>
            {pagine.map((p) => <li><a href={`/servizi/${p.slug}/`}>{p.titolo}</a></li>)}
          </ul>
        </nav>
      )}

      <div class="recapiti">
        <p class="titolo">{g.footer_titolo_contatti}</p>
        <ul class="contatti">
          {g.email && <li><a href={`mailto:${g.email}`}><Icona nome="mail" />{g.email}</a></li>}
          {g.telefono && <li><a href={`tel:${g.telefono.replace(/[^\d+]/g, '')}`}><Icona nome="phone" />{g.telefono}</a></li>}
        </ul>
        {g.dati_legali && <p class="legali">{righe(g.dati_legali).map((r, i) => <>{i > 0 && <br />}{r}</>)}</p>}
      </div>
    </div>

    <div class="fondo">
      <p>© {anno} {g.nome}. {g.copyright}</p>
      {g.credito && <p>{g.credito}</p>}
    </div>
  </div>
</footer>

<style>
  footer { position: relative; margin-top: 4rem; font-size: var(--fs-md); }
  /* Linea sottile colorata in alto */
  footer::before { content: ''; position: absolute; inset: 0 0 auto; height: 1px; background: linear-gradient(90deg, transparent, var(--accent-border), transparent); }
  footer p { margin: 0; }

  .colonne { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem 1.5rem; padding-block: 4.5rem 3.5rem; }
  .marca, .recapiti { grid-column: 1 / -1; }
  @media (min-width: 48rem) { .colonne { grid-template-columns: repeat(3, 1fr); gap: 3rem; } .recapiti { grid-column: auto; } }
  @media (min-width: 64rem) { .colonne { grid-template-columns: 1.6fr 1fr 1fr 1.2fr; } .marca { grid-column: auto; } }

  .marca { display: grid; gap: 1.75rem; align-content: start; }
  .logo { display: inline-block; color: var(--text); line-height: 0; }
  .logo :global(.logo-svg) { display: block; height: 3.25rem; width: auto; max-width: 100%; }
  .descrizione { color: var(--muted); font-size: var(--fs-base); line-height: 1.7; }

  .titolo { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-sm); letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); margin-bottom: 2rem !important; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.9rem; }
  ul a { color: var(--text); text-decoration: none; transition: color 0.2s; }
  ul a:hover { color: var(--accent-light); }
  .contatti a { display: inline-flex; align-items: center; gap: 0.6rem; }
  .contatti :global(svg) { color: var(--accent-light); }
  .legali { margin-top: 2rem !important; color: var(--muted); font-size: var(--fs-xs); line-height: 1.7; }

  .fondo { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.75rem 2rem; padding-block: 1.75rem 2.25rem; border-top: 1px solid var(--border); color: var(--muted); /* grigio pieno: contrasto AA */ font-size: var(--fs-xs); }
</style>
