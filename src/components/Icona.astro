---
import { icone } from '../lib/icone';

interface Props {
  nome: string;
  size?: number;
}
const { nome, size = 16 } = Astro.props;
---

<svg viewBox="0 0 24 24" width={size} height={size} fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icone[nome] ?? ''} />
