---
// Hero della pagina Chi sono: una foto vera della luna (mosaico NASA LRO, public/img/luna.webp) resta al buio
// e appare dentro una scia liquida in WebGL che segue il mouse (o il dito): grande vicino al cursore,
// sempre più sottile man mano che sbiadisce. Quando nessuno la muove, la scia gira da sola.
// Titolo e testi usano mix-blend-mode: difference, quindi cambiano colore sopra la parte illuminata.
import { Image } from 'astro:assets';

interface Props {
  occhiello: string;
  titolo: string;
  testo: string;
  cta: { testo: string; url: string }[];
  foto: string;
  fotoAlt: string;
  badge: string[];
}
const { occhiello, titolo, testo, cta, foto, fotoAlt, badge } = Astro.props;
---

<section class="hero-luna" data-luna>
  <canvas class="luna" aria-hidden="true" data-gl data-src="/img/luna.webp"></canvas>

  <div class="wrap griglia">
    <div class="testo">
      {occhiello && <p class="occhiello" data-blend>{occhiello}</p>}
      <h1 data-blend>{titolo}</h1>
      {testo && <p class="lead" data-blend>{testo}</p>}
      {cta.length > 0 && (
        <p class="cta">
          {cta.map((c, i) => <a class:list={['btn', { 'btn-ghost': i > 0 }]} href={c.url}>{c.testo}</a>)}
        </p>
      )}
    </div>

    <div class:list={['visual', { 'con-foto': foto }]}>
      {foto && (
        <div class="foto">
          <Image
            src={foto}
            alt={fotoAlt}
            inferSize
            format="webp"
            widths={[400, 640, 900]}
            sizes="(min-width: 64rem) 32vw, 80vw"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      )}
      {badge.length > 0 && (
        <ul class="badge" aria-label="Tecnologie">
          {badge.map((b, i) => <li style={`--i: ${i}`}>{b}</li>)}
        </ul>
      )}
    </div>
  </div>
</section>

<script>
  // Scia liquida in WebGL. Due passaggi per fotogramma:
  // 1. "scia": una texture a metà risoluzione che ricorda dove è passato il cursore. Ogni passaggio lascia
  //    un valore che scende dal centro verso il bordo; ogni fotogramma si toglie la stessa quantità a tutti.
  // 2. "luna": la foto si vede dove la scia supera una soglia. Visto che il valore cala in modo costante,
  //    la larghezza visibile si riduce in modo graduale col tempo: la scia parte larga come la goccia sul
  //    cursore e si stringe senza scalini fino a una punta.
  const sez = document.querySelector<HTMLElement>('[data-luna]');
  const canvas = sez?.querySelector<HTMLCanvasElement>('[data-gl]');
  const gl = canvas?.getContext('webgl', { premultipliedAlpha: true, alpha: true, antialias: false });
  if (sez && canvas && !gl) sez.classList.add('senza-gl');

  if (sez && canvas && gl) {
    const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const vert = `attribute vec2 p; varying vec2 uv; void main(){ uv = p * 0.5 + 0.5; gl_Position = vec4(p, 0.0, 1.0); }`;
    const rumore = `
      float hash(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
      float noise(vec2 p){
        vec2 i = floor(p), f = fract(p); f = f * f * (3.0 - 2.0 * f);
        return mix(mix(hash(i), hash(i + vec2(1, 0)), f.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), f.x), f.y);
      }`;
    const fragScia = `precision highp float; varying vec2 uv;
      uniform sampler2D prec; uniform vec2 dim, da, a; uniform float raggio, tempo, togli;
      ${rumore}
      float segmento(vec2 p, vec2 a0, vec2 b0){ vec2 pa = p - a0, ba = b0 - a0; float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-4), 0.0, 1.0); return length(pa - ba * h); }
      void main(){
        // La scia ondeggia come un liquido: si legge il fotogramma prima da un punto spostato dal rumore.
        vec2 n = vec2(noise(uv * 6.0 + tempo * 0.4), noise(uv * 6.0 + 7.3 - tempo * 0.4)) - 0.5;
        float v = texture2D(prec, uv + n * 0.0012).r - togli;
        vec2 px = uv * dim;
        float d = segmento(px, da, a);
        // Profilo a radice: col calo costante la larghezza visibile scende come (tempo rimasto)²,
        // quindi la scia si stringe subito in modo morbido e poi si affina in una punta lunga.
        float m = clamp(1.0 - sqrt(d / raggio), 0.0, 1.0);
        gl_FragColor = vec4(vec3(max(v, m)), 1.0);
      }`;
    const fragLuna = `precision highp float; varying vec2 uv;
      uniform sampler2D scia, luna; uniform vec2 dim, centro; uniform float diametro, tempo, buio;
      ${rumore}
      void main(){
        vec2 px = uv * dim;
        vec2 e = 1.5 / dim;
        float m = texture2D(scia, uv).r;
        // Bordo liquido: la soglia oscilla col rumore.
        float s = 0.42 + (noise(px * 0.012 + tempo * 0.5) - 0.5) * 0.12;
        float dentro = smoothstep(s - 0.02, s + 0.02, m);
        // Rifrazione: vicino al bordo la luna si deforma seguendo la pendenza della scia.
        vec2 g = vec2(texture2D(scia, uv + vec2(e.x, 0.0)).r - texture2D(scia, uv - vec2(e.x, 0.0)).r,
                      texture2D(scia, uv + vec2(0.0, e.y)).r - texture2D(scia, uv - vec2(0.0, e.y)).r);
        vec2 lp = (px - centro) / diametro + 0.5 - g * 0.06 * dentro;
        lp.y = 1.0 - lp.y;
        // Fuori dall'immagine niente: con CLAMP_TO_EDGE il bordo si allungherebbe in strisce.
        vec4 c = texture2D(luna, lp) * step(0.0, lp.x) * step(lp.x, 1.0) * step(0.0, lp.y) * step(lp.y, 1.0);
        float bordo = (smoothstep(s - 0.02, s + 0.02, m) - smoothstep(s + 0.02, s + 0.12, m));
        // Dentro la scia la luna è più chiara: il testo in "difference" diventa scuro e ben leggibile.
        vec3 chiara = c.a - (c.a - c.rgb) * 0.4;
        vec3 col = mix(c.rgb, chiara, dentro) + bordo * 0.18 * c.a;
        gl_FragColor = vec4(col, c.a) * mix(buio, 1.0, dentro);
      }`;

    function programma(f: string) {
      const p = gl!.createProgram()!;
      for (const [tipo, src] of [[gl!.VERTEX_SHADER, vert], [gl!.FRAGMENT_SHADER, f]] as const) {
        const s = gl!.createShader(tipo)!;
        gl!.shaderSource(s, src);
        gl!.compileShader(s);
        if (!gl!.getShaderParameter(s, gl!.COMPILE_STATUS)) console.error(gl!.getShaderInfoLog(s));
        gl!.attachShader(p, s);
      }
      gl!.bindAttribLocation(p, 0, 'p');
      gl!.linkProgram(p);
      const u: Record<string, WebGLUniformLocation | null> = {};
      const n = gl!.getProgramParameter(p, gl!.ACTIVE_UNIFORMS);
      for (let i = 0; i < n; i++) {
        const nome = gl!.getActiveUniform(p, i)!.name;
        u[nome] = gl!.getUniformLocation(p, nome);
      }
      return { p, u };
    }
    const pScia = programma(fragScia);
    const pLuna = programma(fragLuna);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    gl.enableVertexAttribArray(0);
    gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);

    function texture(w: number, h: number) {
      const t = gl!.createTexture()!;
      gl!.bindTexture(gl!.TEXTURE_2D, t);
      gl!.texImage2D(gl!.TEXTURE_2D, 0, gl!.RGBA, w, h, 0, gl!.RGBA, gl!.UNSIGNED_BYTE, null);
      for (const [k, v] of [[gl!.TEXTURE_MIN_FILTER, gl!.LINEAR], [gl!.TEXTURE_MAG_FILTER, gl!.LINEAR], [gl!.TEXTURE_WRAP_S, gl!.CLAMP_TO_EDGE], [gl!.TEXTURE_WRAP_T, gl!.CLAMP_TO_EDGE]]) gl!.texParameteri(gl!.TEXTURE_2D, k, v);
      const fb = gl!.createFramebuffer()!;
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, fb);
      gl!.framebufferTexture2D(gl!.FRAMEBUFFER, gl!.COLOR_ATTACHMENT0, gl!.TEXTURE_2D, t, 0);
      gl!.clearColor(0, 0, 0, 1);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      return { t, fb };
    }

    const lunaTex = gl.createTexture();
    let lunaPronta = false;
    const img = new Image();
    img.onload = () => {
      gl.bindTexture(gl.TEXTURE_2D, lunaTex);
      gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
      for (const [k, v] of [[gl.TEXTURE_MIN_FILTER, gl.LINEAR], [gl.TEXTURE_MAG_FILTER, gl.LINEAR], [gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE], [gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE]]) gl.texParameteri(gl.TEXTURE_2D, k, v);
      lunaPronta = true;
      if (calmo) for (let i = 0; i < 40; i++) disegna(performance.now());
    };
    img.src = canvas.dataset.src!;

    let W = 0, H = 0, dpr = 1, R = 160, ld = 0, lx = 0, ly = 0;
    let scie: { t: WebGLTexture; fb: WebGLFramebuffer }[] = [];
    let sw = 0, sh = 0;
    const meta = { x: 0, y: 0 };
    const testa = { x: 0, y: 0 };
    let prima = { x: 0, y: 0 };
    let ultimoInput = -1e9;
    let visibile = true;
    let raf = 0;
    let avviata = false;
    let ultimo = 0;

    function misura() {
      const r = sez!.getBoundingClientRect();
      W = r.width;
      H = r.height;
      dpr = Math.min(devicePixelRatio || 1, 1.5);
      canvas!.width = Math.round(W * dpr);
      canvas!.height = Math.round(H * dpr);
      const largo = W >= 768;
      ld = largo ? Math.max(H * 1.5, W * 0.95) : Math.max(W * 1.5, H * 0.7);
      lx = largo ? W * 0.64 : W * 0.6;
      ly = largo ? H * 0.58 : H * 0.4;
      // Raggio della testa: con la soglia a ~0.42 si vede circa il 60% di questo valore.
      // Raggio della goccia sul cursore: con il profilo a radice e la soglia a ~0.42 se ne vede circa un terzo.
      R = (largo ? Math.min(380, Math.max(200, W * 0.2)) : W * 0.42) * 1.73;
      sw = Math.max(2, Math.round(W / 2));
      sh = Math.max(2, Math.round(H / 2));
      scie = [texture(sw, sh), texture(sw, sh)];
      if (!avviata) {
        avviata = true;
        meta.x = testa.x = prima.x = W * 0.62;
        meta.y = testa.y = prima.y = H * 0.5;
      }
    }

    function disegna(ora: number) {
      raf = 0;
      if (!lunaPronta) {
        if (visibile && !calmo) raf = requestAnimationFrame(disegna);
        return;
      }
      const t = ora / 1000;
      // Tutto è tarato su 60 fotogrammi al secondo: con schermi più lenti o più veloci la scia dura uguale.
      const passi = ultimo ? Math.min(4, (ora - ultimo) / 16.67) : 1;
      ultimo = ora;
      if (!calmo && ora - ultimoInput > 2500) {
        meta.x = W * 0.5 + Math.cos(t * 0.35) * W * 0.3;
        meta.y = H * 0.5 + Math.sin(t * 0.55) * H * 0.26;
      }
      prima = { ...testa };
      const k = 1 - Math.pow(1 - 0.16, passi);
      testa.x += (meta.x - testa.x) * k;
      testa.y += (meta.y - testa.y) * k;

      // 1. aggiorna la scia (coordinate in pixel CSS, y dal basso)
      const [leggi, scrivi] = scie;
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, scrivi.fb);
      gl!.viewport(0, 0, sw, sh);
      gl!.useProgram(pScia.p);
      gl!.activeTexture(gl!.TEXTURE0);
      gl!.bindTexture(gl!.TEXTURE_2D, leggi.t);
      gl!.uniform1i(pScia.u.prec, 0);
      gl!.uniform2f(pScia.u.dim, W, H);
      gl!.uniform2f(pScia.u.da, prima.x, H - prima.y);
      gl!.uniform2f(pScia.u.a, testa.x, H - testa.y);
      gl!.uniform1f(pScia.u.raggio, R);
      gl!.uniform1f(pScia.u.tempo, t);
      // La scia impiega circa 2,6 secondi a stringersi fino a sparire.
      gl!.uniform1f(pScia.u.togli, (0.58 / 155) * passi);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);
      scie = [scrivi, leggi];

      // 2. disegna la luna attraverso la scia
      gl!.bindFramebuffer(gl!.FRAMEBUFFER, null);
      gl!.viewport(0, 0, canvas!.width, canvas!.height);
      gl!.clearColor(0, 0, 0, 0);
      gl!.clear(gl!.COLOR_BUFFER_BIT);
      gl!.useProgram(pLuna.p);
      gl!.activeTexture(gl!.TEXTURE0);
      gl!.bindTexture(gl!.TEXTURE_2D, scrivi.t);
      gl!.uniform1i(pLuna.u.scia, 0);
      gl!.activeTexture(gl!.TEXTURE1);
      gl!.bindTexture(gl!.TEXTURE_2D, lunaTex);
      gl!.uniform1i(pLuna.u.luna, 1);
      gl!.uniform2f(pLuna.u.dim, W, H);
      gl!.uniform2f(pLuna.u.centro, lx, H - ly);
      gl!.uniform1f(pLuna.u.diametro, ld);
      gl!.uniform1f(pLuna.u.tempo, t);
      gl!.uniform1f(pLuna.u.buio, 0.1);
      gl!.drawArrays(gl!.TRIANGLE_STRIP, 0, 4);

      if (visibile && !calmo) raf = requestAnimationFrame(disegna);
    }

    function muovi(cx: number, cy: number) {
      const r = sez!.getBoundingClientRect();
      ultimoInput = performance.now();
      meta.x = cx - r.left;
      meta.y = cy - r.top;
    }

    misura();
    let attesa = 0;
    addEventListener('resize', () => {
      clearTimeout(attesa);
      attesa = window.setTimeout(() => {
        misura();
        if (calmo) for (let i = 0; i < 40; i++) disegna(performance.now());
      }, 150);
    });

    if (!calmo) {
      sez.addEventListener('pointermove', (e) => muovi(e.clientX, e.clientY));
      sez.addEventListener('pointerdown', (e) => muovi(e.clientX, e.clientY));
      // Su telefono il dito che scorre la pagina interrompe i pointer event: si ascolta anche il touch.
      sez.addEventListener('touchmove', (e) => muovi(e.touches[0].clientX, e.touches[0].clientY), { passive: true });
      new IntersectionObserver(([v]) => {
        visibile = v.isIntersecting;
        if (visibile && !raf) raf = requestAnimationFrame(disegna);
      }).observe(sez);
    }
  }
</script>

<style>
  .hero-luna {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    isolation: isolate;
    background: var(--bg);
    padding-block: 7rem 4rem;
  }
  .luna { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
  /* Senza WebGL la luna resta visibile, appena accennata */
  .senza-gl::before { content: ''; position: absolute; inset: 0; background: url('/img/luna.webp') 65% 55% / auto 150% no-repeat; opacity: 0.18; }

  .griglia { position: relative; width: 100%; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2.5rem 1.5rem; align-items: center; }
  .testo { grid-column: 1 / -1; }
  .visual { grid-column: 1 / -1; position: relative; }
  @media (min-width: 64rem) {
    .testo { grid-column: 1 / span 7; }
    .visual { grid-column: 8 / -1; min-height: 30rem; }
  }

  [data-blend] { color: var(--white); mix-blend-mode: difference; }
  .occhiello { margin: 0 0 1.5rem; font-family: var(--mono); font-size: var(--fs-xs); letter-spacing: 0.18em; text-transform: uppercase; }
  h1 { margin: 0; font-size: clamp(2rem, 4.2vw, 3.9rem); line-height: 1.08; }
  .lead { margin: 1.75rem 0 0; max-width: 36rem; font-size: var(--fs-lead); line-height: 1.6; }
  .cta { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 2.25rem 0 0; }
  .cta .btn { min-height: 48px; display: inline-flex; align-items: center; transition: transform 0.25s cubic-bezier(.2, .8, .2, 1), box-shadow 0.25s, background 0.2s; }
  .cta .btn:hover { transform: translateY(-3px); box-shadow: 0 12px 28px -12px var(--accent); }
  .cta .btn-ghost { background: color-mix(in srgb, var(--bg) 70%, transparent); color: var(--text); border-color: var(--border); backdrop-filter: blur(6px); }

  .foto { position: relative; width: min(100%, 24rem); margin-inline: auto; aspect-ratio: 4 / 5; border-radius: calc(var(--radius) * 1.5); overflow: hidden; border: 1px solid var(--border); box-shadow: 0 30px 80px -30px rgb(0 0 0 / 0.8); }
  .foto img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Badge flottanti: attorno alla foto, o attorno alla luna se la foto non c'è */
  .badge { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .badge li {
    padding: 0.6rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 75%, transparent);
    backdrop-filter: blur(8px);
    font-family: var(--mono);
    font-size: var(--fs-sm);
    color: var(--text);
    transition: border-color 0.25s, color 0.25s, box-shadow 0.25s;
  }
  .badge li:hover { border-color: var(--accent-light); color: var(--accent-glow); box-shadow: 0 0 24px -4px var(--accent); }
  .con-foto .badge { margin-top: 1.25rem; justify-content: center; }

  @media (min-width: 64rem) {
    .badge { position: absolute; inset: 0; display: block; pointer-events: none; }
    .badge li { position: absolute; pointer-events: auto; animation: galleggia 6s ease-in-out infinite; animation-delay: calc(var(--i) * -1.4s); }
    .badge li:nth-child(6n + 1) { top: 12%; left: 6%; }
    .badge li:nth-child(6n + 2) { top: 26%; right: 2%; }
    .badge li:nth-child(6n + 3) { bottom: 24%; left: 0; }
    .badge li:nth-child(6n + 4) { bottom: 9%; right: 10%; }
    .badge li:nth-child(6n + 5) { top: 2%; right: 30%; }
    .badge li:nth-child(6n + 6) { bottom: 0; left: 34%; }
    .con-foto .badge { margin: 0; }
  }
  @keyframes galleggia { 50% { translate: 0 -10px; } }
  @media (prefers-reduced-motion: reduce) { .badge li { animation: none !important; } }
</style>
