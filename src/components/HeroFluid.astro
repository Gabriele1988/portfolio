---
import { sito } from '../site.config';
---

<section class="hero" data-hero>
  <canvas class="fluid" aria-hidden="true"></canvas>
  <div class="wrap content">
    <p class="kicker" data-blend>{sito.ruolo} · {sito.citta}</p>
    <h1 data-blend>Siti veloci e applicazioni web su misura.</h1>
    <p class="lead" data-blend>{sito.descrizione}</p>
    <p class="cta">
      <a class="btn" href="/contatti/">Richiedi un preventivo</a>
      <a class="btn btn-ghost" href="/progetti/">Guarda i progetti</a>
    </p>
  </div>
  <a class="scroll" href="#servizi" aria-label="Scorri ai servizi">
    <span class="mouse" aria-hidden="true"><span class="rotella"></span></span>
  </a>
</section>

<script>
  import { startFluid } from '../scripts/fluid';

  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvas = hero.querySelector<HTMLCanvasElement>('canvas')!;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  const stop = reduce ? null : startFluid(canvas, { target: hero });
  hero.classList.add(stop ? 'is-live' : 'is-static');
</script>

<style>
  /* La hero è scura come tutto il sito: il fumo rende meglio e il testo "in negativo" funziona su fondo scuro. */
  .hero {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--white);
    /* Stesso nero del resto della pagina (niente stacco), ma senza stelle e comete. */
    background: var(--bg);
    touch-action: pan-y;
  }
  /* Niente z-index su canvas e contenuto: devono stare nello stesso contesto
     perché il testo possa fondersi con il fumo (mix-blend-mode). */
  .fluid {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .hero.is-live .fluid { opacity: 1; }
  /* Senza WebGL o con "riduci movimento": sfondo sfumato statico. */
  .hero.is-static {
    background:
      radial-gradient(60% 50% at 20% 30%, rgb(70 60 200 / 0.35), transparent 70%),
      radial-gradient(50% 45% at 80% 70%, rgb(20 140 200 / 0.3), transparent 70%),
      var(--bg);
  }

  .content {
    position: relative;
    width: 100%;
    padding-block: 7rem 5rem;
  }
  /* Testo bianco in "difference": dove passa il fumo il testo assume il colore opposto,
     come se testo e sfondo fossero un'unica superficie. */
  [data-blend] {
    color: var(--white);
    mix-blend-mode: difference;
  }
  h1 {
    font-size: var(--fs-hero);
    line-height: 1;
    letter-spacing: -0.035em;
    max-width: 14ch;
    margin: 0 0 1.5rem;
  }
  .kicker { font-size: var(--fs-ui); letter-spacing: 0.04em; text-transform: uppercase; margin: 0 0 1.25rem; opacity: 0.85; }
  .lead { font-size: var(--fs-lead); max-width: 40rem; margin: 0; opacity: 0.9; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 2.5rem; }
  .cta .btn { background: var(--white); color: var(--bg); }
  .cta .btn-ghost { background: transparent; color: var(--white); border-color: color-mix(in srgb, var(--white) 40%, transparent); backdrop-filter: blur(6px); }

  .scroll {
    position: absolute;
    left: 50%;
    translate: -50% 0;
    bottom: 2rem;
    color: color-mix(in srgb, var(--white) 70%, transparent);
    transition: color 0.2s;
  }
  .scroll:hover { color: var(--white); }
  .mouse {
    display: block;
    width: 1.5rem;
    height: 2.4rem;
    border: 2px solid currentColor;
    border-radius: 999px;
    position: relative;
  }
  .rotella {
    position: absolute;
    left: 50%;
    top: 0.45rem;
    width: 3px;
    height: 0.5rem;
    margin-left: -1.5px;
    border-radius: 3px;
    background: currentColor;
    animation: rotella 1.8s cubic-bezier(.6,0,.4,1) infinite;
  }
  @keyframes rotella {
    0% { transform: translateY(0); opacity: 0; }
    15% { opacity: 1; }
    65% { transform: translateY(0.75rem); opacity: 0; }
    100% { transform: translateY(0.75rem); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .rotella { animation: none; } }
</style>
