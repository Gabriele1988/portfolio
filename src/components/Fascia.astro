---
// Fascia a tutta larghezza con i bordi "strappati" sopra e sotto (come carta strappata) e nuvole viola lungo lo strappo.
// I bordi sono disegnati qui in SVG a partire da un seme: ogni fascia ha uno strappo diverso, ma sempre uguale tra un build e l'altro.
interface Props {
  seme: string;
  class?: string;
}
const { seme, class: classe = '' } = Astro.props;

// Generatore pseudo-casuale con seme (mulberry32).
const hash = (s: string) => [...s].reduce((h, c) => (Math.imul(h ^ c.charCodeAt(0), 2654435761) >>> 0), 2166136261);
const casuale = (n: number) => () => {
  n = (n + 0x6d2b79f5) >>> 0;
  let t = n;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

const L = 2400; // larghezza del disegno: su schermo si vede la parte centrale, senza deformarlo
const A = 140; // altezza
const r2 = (v: number) => Math.round(v * 10) / 10;

/** Disegna lo strappo: la parte piena (colore della fascia) sta sotto la linea, con schegge staccate sopra e qualche buco sotto. */
const strappo = (rnd: () => number) => {
  // rumore "a valori" liscio per le ondulazioni medie
  const nodi = Array.from({ length: 80 }, () => rnd() * 2 - 1);
  const rumore = (x: number, passo: number) => {
    const t = x / passo;
    const i = Math.floor(t);
    const f = t - i;
    const s = f * f * (3 - 2 * f);
    return nodi[i % nodi.length] * (1 - s) + nodi[(i + 1) % nodi.length] * s;
  };
  const fasi = [rnd() * 6.28, rnd() * 6.28, rnd() * 6.28];
  const quota = (x: number) =>
    A * 0.58 +
    Math.sin(x / 330 + fasi[0]) * 22 +
    Math.sin(x / 140 + fasi[1]) * 12 +
    Math.sin(x / 61 + fasi[2]) * 5 +
    rumore(x, 55) * 16 +
    rumore(x + 900, 17) * 5;

  const punti: [number, number][] = [];
  for (let x = 0; x <= L; x += 3 + rnd() * 9) {
    let y = quota(x) + (rnd() - 0.5) * 6;
    // ogni tanto una linguetta di carta che sale, larga qualche punto
    if (rnd() < 0.025) {
      const alta = 10 + rnd() * 18;
      punti.push([x, y - alta * 0.5], [x + 4 + rnd() * 4, y - alta], [x + 9 + rnd() * 6, y - alta * 0.35]);
      x += 12;
      continue;
    }
    punti.push([x, y]);
  }
  punti.push([L, quota(L)]);
  const bordo = `M0 ${A} L` + punti.map(([x, y]) => `${r2(x)} ${r2(y)}`).join(' L') + ` L${L} ${A} Z`;

  // schegge: piccoli frammenti irregolari staccati, più fitti vicino allo strappo
  const scheggia = (cx: number, cy: number, raggio: number) => {
    const lati = 4 + Math.floor(rnd() * 4);
    const p: string[] = [];
    for (let k = 0; k < lati; k++) {
      const ang = (k / lati) * Math.PI * 2 + rnd() * 0.6;
      const rr = raggio * (0.45 + rnd() * 0.75);
      p.push(`${r2(cx + Math.cos(ang) * rr)} ${r2(cy + Math.sin(ang) * rr * 0.7)}`);
    }
    return `M${p.join(' L')} Z`;
  };
  let schegge = '';
  for (let k = 0; k < 150; k++) {
    const x = rnd() * L;
    const distanza = Math.pow(rnd(), 2.2) * 50 + 3;
    schegge += scheggia(x, quota(x) - distanza, 0.8 + rnd() * (distanza < 15 ? 6 : 3));
  }
  let buchi = '';
  for (let k = 0; k < 70; k++) {
    const x = rnd() * L;
    const distanza = Math.pow(rnd(), 2) * 40 + 7;
    buchi += scheggia(x, quota(x) + distanza, 0.7 + rnd() * 3.2);
  }
  // nuvole lungo lo strappo: posizione (%), larghezza, colore
  const nuvole = Array.from({ length: 5 }, (_, k) => ({
    x: r2((k + 0.2 + rnd() * 0.6) * 20),
    w: r2(18 + rnd() * 16),
    c: rnd() < 0.55 ? 'v' : rnd() < 0.5 ? 'f' : 'g',
    d: r2(14 + rnd() * 12),
  }));
  return { bordo, schegge, buchi, nuvole };
};

const rnd = casuale(hash(seme));
const sopra = strappo(rnd);
const sotto = strappo(rnd);
---

<div class:list={['fascia', classe]}>
  <div class="strappo sopra" aria-hidden="true">
    <svg viewBox={`0 0 ${L} ${A}`} preserveAspectRatio="xMidYMax slice" focusable="false">
      <path d={sopra.bordo + sopra.schegge} />
      <path class="buco" d={sopra.buchi} />
    </svg>
    {sopra.nuvole.map((n) => <span class:list={['nuvola', n.c]} style={`--x: ${n.x}%; --w: ${n.w}vw; --d: ${n.d}s`} />)}
  </div>
  <div class="interno">
    <slot />
  </div>
  <div class="strappo sotto" aria-hidden="true">
    <svg viewBox={`0 0 ${L} ${A}`} preserveAspectRatio="xMidYMax slice" focusable="false">
      <path d={sotto.bordo + sotto.schegge} />
      <path class="buco" d={sotto.buchi} />
    </svg>
    {sotto.nuvole.map((n) => <span class:list={['nuvola', n.c]} style={`--x: ${n.x}%; --w: ${n.w}vw; --d: ${n.d}s`} />)}
  </div>
</div>

<style>
  .fascia {
    --fascia: color-mix(in srgb, var(--accent-btn) 20%, var(--bg));
    --h-strappo: clamp(70px, 9vw, 140px);
    position: relative;
    isolation: isolate;
    margin-block: calc(var(--h-strappo) + clamp(1.5rem, 4vw, 3rem));
    overflow-x: clip; /* le nuvole ai lati non devono allargare la pagina */
    background:
      radial-gradient(60% 50% at 15% 40%, color-mix(in srgb, var(--accent-btn) 22%, transparent), transparent),
      radial-gradient(45% 45% at 90% 70%, color-mix(in srgb, var(--accent-light) 10%, transparent), transparent),
      var(--fascia);
  }
  /* stelline fisse sulla fascia (il cielo stellato del sito resta sotto e non si vedrebbe) */
  .fascia::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.55;
    background-image:
      radial-gradient(1px 1px at 20px 30px, var(--white), transparent),
      radial-gradient(1px 1px at 140px 90px, var(--accent-glow), transparent),
      radial-gradient(1.5px 1.5px at 260px 180px, var(--white), transparent),
      radial-gradient(1px 1px at 80px 230px, var(--white), transparent),
      radial-gradient(1px 1px at 330px 40px, var(--white), transparent);
    background-size: 380px 260px;
  }
  .interno { position: relative; }
  .strappo { position: absolute; left: 0; right: 0; height: var(--h-strappo); pointer-events: none; }
  .strappo.sopra { bottom: calc(100% - 1px); }
  .strappo.sotto { top: calc(100% - 1px); transform: scaleY(-1); }
  .strappo svg { display: block; width: 100%; height: 100%; fill: var(--fascia); overflow: visible; }
  .strappo .buco { fill: var(--bg); }
  .sotto .nuvola { animation-direction: alternate-reverse; }
  /* nuvole morbide lungo lo strappo, nei viola del sito */
  .nuvola {
    position: absolute;
    left: calc(var(--x) - var(--w) / 2);
    bottom: 10%;
    width: var(--w);
    height: calc(var(--h-strappo) * 1.1);
    border-radius: 50%;
    /* tre sbuffi sovrapposti: sembra una nuvola, non un ovale */
    background:
      radial-gradient(28% 38% at 30% 60%, var(--c), transparent),
      radial-gradient(28% 48% at 56% 50%, var(--c), transparent),
      radial-gradient(18% 32% at 80% 64%, var(--c), transparent);
    animation: nuvola var(--d) ease-in-out infinite alternate;
  }
  .nuvola.v { --c: color-mix(in srgb, var(--accent-btn) 45%, transparent); }
  .nuvola.f { --c: color-mix(in srgb, var(--accent-light) 25%, transparent); }
  .nuvola.g { --c: color-mix(in srgb, var(--accent) 22%, transparent); }
  @keyframes nuvola { to { transform: translate3d(4vw, -8%, 0) scale(1.15); } }
  @media (prefers-reduced-motion: reduce) { .nuvola { animation: none; } }
</style>
