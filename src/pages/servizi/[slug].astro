---
// Pagina di un singolo servizio, in stile "pannelli scuri con bagliori viola": titoli maiuscoli su righe sfalsate,
// elenchi a righe sottili, il percorso a gradini in diagonale, i progetti realizzati, gli altri servizi e la chiamata finale.
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Icona from '../../components/Icona.astro';
import ProgettoCard from '../../components/ProgettoCard.astro';
import RigheTesto from '../../components/RigheTesto.astro';
import { icone } from '../../lib/icone';
import { getPagineServizi, progettiDi, type PaginaServizio } from '../../lib/pagineServizi';
import { getProgetti } from '../../lib/wp';
import { getTesti } from '../../lib/testi';

export const getStaticPaths = (async () => {
  const pagine = await getPagineServizi();
  return pagine.map((pagina) => ({ params: { slug: pagina.slug }, props: { pagina } }));
}) satisfies GetStaticPaths;

const { pagina: s } = Astro.props as { pagina: PaginaServizio };
const [pagine, progetti, testi] = await Promise.all([getPagineServizi(), getProgetti(), getTesti()]);
const t = testi.pag_servizi;
const g = testi.generale;
const collegati = progettiDi(s, progetti).slice(0, 3);
const altri = pagine.filter((p) => p.slug !== s.slug);
const indice = pagine.findIndex((p) => p.slug === s.slug);
const pad = (n: number) => String(n).padStart(2, '0');

// Divide un titolo in 1-3 righe di lunghezza simile: ogni riga poi viene spostata un po' a destra (effetto sfalsato).
const sfalsa = (testo: string, massimo = 3): string[] => {
  const parole = testo.trim().split(/\s+/).filter(Boolean);
  const n = Math.min(massimo, parole.length <= 1 ? 1 : parole.length <= 4 ? 2 : 3);
  const totale = parole.join(' ').length;
  const righe: string[] = [];
  let corrente: string[] = [];
  for (const parola of parole) {
    const lunghezza = [...corrente, parola].join(' ').length;
    const resto = n - righe.length - 1;
    if (corrente.length && resto > 0 && lunghezza > totale / n + 2) {
      righe.push(corrente.join(' '));
      corrente = [];
    }
    corrente.push(parola);
  }
  if (corrente.length) righe.push(corrente.join(' '));
  return righe;
};
// Quanto si sposta ogni riga (in multipli del passo dello sfalsamento).
const scarti = [0, 1, 0.45];
// Il percorso a gradini: fino a 4 fasi in una sola scala, oltre si va a capo con scale da 3.
const perGradino = s.passi.length <= 4 ? Math.max(1, s.passi.length) : 3;
const nastro = (s.include.length ? s.include : s.vantaggi.map((v) => v.titolo)).slice(0, 8);

const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Service',
      name: s.titolo,
      description: s.seo_descrizione || s.intro,
      url,
      serviceType: s.titolo,
      areaServed: 'IT',
      provider: { '@type': 'Person', name: g.nome, url: new URL('/', Astro.site).href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Servizi', item: new URL('/servizi/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: s.titolo, item: url },
      ],
    },
  ],
};
---

<Base title={s.seo_titolo || s.titolo} description={s.seo_descrizione || s.intro}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <RigheTesto slot="head" />

  <div class="wrap">
    <section class="pannello eroe">
      <span class="bagliore b1" aria-hidden="true"></span>
      <span class="bagliore b2" aria-hidden="true"></span>
      <nav class="briciole" aria-label="Percorso">
        <a href="/servizi/">Servizi</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{s.titolo}</span>
        <span class="contatore">{pad(indice + 1)} / {pad(pagine.length)}</span>
      </nav>
      <div class="eroe-griglia">
        <h1 class="sfalsato" data-righe="subito">
          {sfalsa(s.titolo).map((r, i) => <span class="riga-s" style={`--s: ${scarti[i]}`}>{r}</span>)}
        </h1>
        <div class="eroe-lato">
          {s.sottotitolo && <p class="sottotitolo" data-righe="subito" style="--ritardo: 0.15s">{s.sottotitolo}</p>}
          {s.intro && <p class="intro" data-righe="subito" style="--ritardo: 0.25s">{s.intro}</p>}
          <p class="link-riga">
            <a class="sottolineato" href="/contatti/">Richiedi un preventivo <span aria-hidden="true">↘</span></a>
            {s.passi.length > 0 && <a class="sottolineato tenue" href="#percorso">Come lavoro <span aria-hidden="true">↓</span></a>}
          </p>
        </div>
      </div>
      {nastro.length > 0 && (
        <div class="nastro" aria-hidden="true">
          <div class="nastro-scorre">
            {[0, 1].map(() => (
              <span class="nastro-gruppo">{nastro.map((v) => <span>{v}<i>✦</i></span>)}</span>
            ))}
          </div>
        </div>
      )}
    </section>
  </div>

  {s.problema_titolo && (
    <section class="wrap section problema">
      <p class="etichetta">Il problema</p>
      <div class="due-colonne">
        <h2 class="sfalsato medio" data-righe>
          {sfalsa(s.problema_titolo).map((r, i) => <span class="riga-s" style={`--s: ${scarti[i]}`}>{r}</span>)}
        </h2>
        {s.problema_testo && <p class="testo-lato" data-righe style="--ritardo: 0.2s">{s.problema_testo}</p>}
      </div>
    </section>
  )}

  {s.vantaggi.length > 0 && (
    <section class="wrap section">
      <div class="due-colonne testa-sezione">
        <div>
          <p class="etichetta">La soluzione</p>
          <h2 class="sfalsato medio" data-righe>
            {sfalsa(`${s.vantaggi_titolo || 'Un servizio che'}…`).map((r, i) => <span class="riga-s" style={`--s: ${scarti[i]}`}>{r}</span>)}
          </h2>
        </div>
        <p class="link-riga fine"><a class="sottolineato" href="/contatti/">Parliamone <span aria-hidden="true">↘</span></a></p>
      </div>
      <ul class="righe-lista">
        {s.vantaggi.map((v) => (
          <li data-appari>
            <span class="punto" aria-hidden="true"></span>
            <h3>{v.titolo}</h3>
            {v.testo && <p>{v.testo}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {s.include.length > 0 && (
    <section class="wrap section">
      <p class="etichetta">Cosa include</p>
      <ul class="include">
        {s.include.map((v, i) => <li style={`--i: ${i % 3}`} data-appari><span class="num">{pad(i + 1)}</span>{v}</li>)}
      </ul>
    </section>
  )}

  {s.passi.length > 0 && (
    <div class="wrap" id="percorso">
      <section class="pannello percorso" style={`--colonne: repeat(${perGradino}, minmax(0, 1fr))`}>
        <span class="bagliore b3" aria-hidden="true"></span>
        <span class="bagliore b4" aria-hidden="true"></span>
        <div class="percorso-testa">
          <div class="percorso-info">
            <p class="etichetta">Il percorso</p>
            <p class="testo-lato" data-righe>Ogni fase risponde a una domanda precisa: sai sempre a che punto siamo e cosa succede dopo.</p>
            <p class="link-riga"><a class="sottolineato" href="/contatti/">Iniziamo <span aria-hidden="true">↘</span></a></p>
          </div>
          <h2 class="sfalsato medio a-destra" data-righe>
            <span class="riga-s" style="--s: 0">Le fasi</span>
            <span class="riga-s" style="--s: 1">del lavoro</span>
            <span class="riga-s" style="--s: 0.45">insieme</span>
          </h2>
        </div>
        <ol class="scala">
          {s.passi.map((p, i) => (
            <li style={`--g: ${i % perGradino}; --gm: ${(i / Math.max(1, s.passi.length - 1)).toFixed(3)}`} data-appari>
              <span class="num">{pad(i + 1)}</span>
              {p.domanda && <p class="domanda">{p.domanda}</p>}
              <h3>{p.titolo}</h3>
              {p.testo && <p>{p.testo}</p>}
            </li>
          ))}
        </ol>
      </section>
    </div>
  )}

  {collegati.length > 0 && (
    <section class="wrap section">
      <div class="due-colonne testa-sezione">
        <h2 class="sfalsato medio" data-righe>
          <span class="riga-s" style="--s: 0">Progetti</span>
          <span class="riga-s" style="--s: 1">realizzati</span>
        </h2>
        <p class="link-riga fine"><a class="sottolineato" href="/progetti/">Tutti i progetti <span aria-hidden="true">↘</span></a></p>
      </div>
      <div class="progetti">
        {collegati.map((p) => <ProgettoCard progetto={p} testi={testi.progetti} sizes="(min-width: 64rem) 30vw, (min-width: 40rem) 45vw, 100vw" />)}
      </div>
    </section>
  )}

  <section class="wrap section dopo">
    <div class="due-colonne">
      <h2 class="sfalsato medio" data-righe>
        <span class="riga-s" style="--s: 0">Dopo la</span>
        <span class="riga-s" style="--s: 1">consegna</span>
      </h2>
      {s.dopo && <p class="testo-lato" data-righe style="--ritardo: 0.2s">{s.dopo}</p>}
    </div>
    {altri.length > 0 && (
      <>
        <p class="etichetta spazio">Altri servizi</p>
        <ul class="altri">
          {altri.map((a, i) => (
            <li data-appari>
              <a href={`/servizi/${a.slug}/`}>
                <span class="num">{pad(i + 1)}</span>
                <span class="nome">{a.titolo}</span>
                <span class="freccia" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </section>

  <div class="wrap fondo">
    <section class="pannello chiusura">
      <span class="bagliore b5" aria-hidden="true"></span>
      <h2 class="sfalsato medio" data-righe>
        {sfalsa(t.cta_titolo).map((r, i) => <span class="riga-s" style={`--s: ${scarti[i]}`}>{r}</span>)}
      </h2>
      <div class="chiusura-lato">
        {t.cta_testo && <p class="testo-lato" data-righe style="--ritardo: 0.2s">{t.cta_testo}</p>}
        <a class="btn grande" href="/contatti/">{t.cta_pulsante}<Icona nome="arrowRight" /></a>
      </div>
    </section>
  </div>
</Base>

<style>
  /* Righe sottili e bagliori: tutto a partire dai colori del sito. */
  .pannello {
    --linea: color-mix(in srgb, var(--text) 14%, transparent);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: clamp(18px, 2vw, 28px);
    background: color-mix(in srgb, var(--surface) 70%, var(--bg));
    padding: clamp(1.25rem, 4vw, 3.5rem);
  }
  .section { --linea: color-mix(in srgb, var(--text) 14%, transparent); }
  .bagliore {
    position: absolute;
    z-index: -1;
    border-radius: 50%;
    pointer-events: none;
    background: radial-gradient(closest-side, var(--c) , transparent);
    animation: deriva 18s ease-in-out infinite alternate;
  }
  .b1 { --c: color-mix(in srgb, var(--accent-btn) 85%, transparent); width: 85%; height: 150%; right: -25%; bottom: -70%; }
  .b2 { --c: color-mix(in srgb, var(--accent-light) 35%, transparent); width: 50%; height: 90%; right: 5%; bottom: -55%; animation-duration: 23s; animation-direction: alternate-reverse; }
  .b3 { --c: color-mix(in srgb, var(--accent-btn) 75%, transparent); width: 90%; height: 90%; left: -20%; bottom: -35%; }
  .b4 { --c: color-mix(in srgb, var(--accent-light) 28%, transparent); width: 55%; height: 60%; right: -15%; top: -25%; animation-duration: 21s; }
  .b5 { --c: color-mix(in srgb, var(--accent-btn) 85%, transparent); width: 90%; height: 170%; left: 15%; top: -60%; }
  @keyframes deriva { to { transform: translate3d(-6%, 5%, 0) scale(1.08); } }
  @media (prefers-reduced-motion: reduce) { .bagliore, .nastro-scorre { animation: none !important; } }

  .etichetta { font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--muted); margin: 0 0 1rem; }
  .etichetta.spazio { margin-top: clamp(3rem, 6vw, 5rem); }

  /* Titoli maiuscoli su righe sfalsate. */
  .sfalsato { --passo: clamp(1.25rem, 9vw, 10rem); font-family: var(--font-display); text-transform: uppercase; font-weight: 600; line-height: 0.95; letter-spacing: -0.01em; margin: 0; overflow-wrap: anywhere; }
  .riga-s { display: block; padding-left: calc(var(--s) * var(--passo)); }
  .sfalsato.medio { --passo: clamp(1rem, 6vw, 6rem); font-size: clamp(2rem, 5vw, 4.5rem); }
  .sfalsato.a-destra { text-align: right; }
  .sfalsato.a-destra .riga-s { padding-left: 0; padding-right: calc((1 - var(--s)) * var(--passo)); }

  .sottolineato { display: inline-flex; align-items: center; gap: 0.5rem; padding-bottom: 0.3rem; border-bottom: 1px solid currentColor; color: var(--text); text-decoration: none; font-weight: 600; font-size: var(--fs-sm); letter-spacing: 0.14em; text-transform: uppercase; transition: color 0.25s, gap 0.25s; }
  .sottolineato:hover { color: var(--accent); gap: 0.8rem; }
  .sottolineato.tenue { color: var(--muted); }
  .link-riga { display: flex; flex-wrap: wrap; gap: 1.5rem 2.25rem; margin: 2rem 0 0; }
  .link-riga.fine { margin: 0; align-self: end; justify-content: flex-end; }

  .testo-lato { margin: 0; color: var(--text-soft); font-size: var(--fs-lead); line-height: 1.65; max-width: 36rem; }
  .due-colonne { display: grid; gap: 1.75rem; }
  @media (min-width: 64rem) { .due-colonne { grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: 3rem; align-items: end; } }
  .testa-sezione { margin-bottom: clamp(2rem, 4vw, 3.5rem); }

  /* Eroe */
  .eroe { margin-top: clamp(0.5rem, 2vw, 1.5rem); padding-bottom: 0; }
  .briciole { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; margin-bottom: clamp(2.5rem, 7vw, 6rem); font-size: var(--fs-xs); font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); }
  .briciole a { color: var(--text-soft); text-decoration: none; }
  .briciole a:hover { color: var(--accent); }
  .briciole [aria-current] { color: var(--accent); }
  .contatore { margin-left: auto; font-variant-numeric: tabular-nums; }
  .eroe-griglia { display: grid; gap: 2rem; }
  @media (min-width: 64rem) { .eroe-griglia { grid-template-columns: minmax(0, 1fr) minmax(16rem, 26rem); align-items: end; gap: 3rem; } }
  .eroe h1 { font-size: clamp(2.5rem, 10.5vw, 4.5rem); color: var(--white); }
  @media (min-width: 64rem) { .eroe h1 { font-size: clamp(4rem, 8.5vw, 8rem); } }
  .sottotitolo { margin: 0 0 1rem; color: var(--accent); text-transform: uppercase; font-weight: 600; font-size: var(--fs-sm); letter-spacing: 0.14em; }
  .intro { color: var(--text-soft); font-size: var(--fs-md); line-height: 1.7; margin: 0; }

  .nastro { margin: clamp(2.5rem, 6vw, 5rem) calc(-1 * clamp(1.25rem, 4vw, 3.5rem)) 0; border-top: 1px solid var(--linea); padding: 1.4rem 0; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent); }
  .nastro-scorre { display: flex; width: max-content; animation: scorre 40s linear infinite; }
  .nastro-gruppo { display: flex; flex-shrink: 0; }
  .nastro-gruppo > span { display: inline-flex; align-items: center; gap: 2.5rem; padding-right: 2.5rem; white-space: nowrap; font-size: var(--fs-sm); font-weight: 500; letter-spacing: 0.35em; text-transform: uppercase; color: var(--text-soft); }
  .nastro i { font-style: normal; color: var(--accent); letter-spacing: 0; }
  @keyframes scorre { to { transform: translateX(-50%); } }

  /* Il problema */
  .problema .sfalsato { color: var(--white); }

  /* Vantaggi: righe sottili, punto · titolo · descrizione */
  .righe-lista { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--linea); }
  .righe-lista li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 0.4rem 1.25rem; padding: 1.5rem 0; border-top: 1px solid var(--linea); }
  @media (min-width: 64rem) { .righe-lista li { grid-template-columns: 2rem minmax(0, 1fr) minmax(0, 1.1fr); align-items: baseline; gap: 2rem; padding: 2rem 0; } }
  .punto { width: 0.45rem; height: 0.45rem; margin-top: 0.55rem; border-radius: 50%; background: var(--text); align-self: start; }
  .righe-lista h3 { margin: 0; font-family: var(--font-display); font-size: clamp(1.15rem, 2vw, 1.6rem); font-weight: 600; line-height: 1.2; text-transform: uppercase; color: var(--accent); }
  .righe-lista p { margin: 0; color: var(--text-soft); line-height: 1.65; grid-column: 2; }
  @media (min-width: 64rem) { .righe-lista p { grid-column: 3; } }

  /* Cosa include */
  .include { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--linea); }
  @media (min-width: 40rem) { .include { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; } }
  @media (min-width: 64rem) { .include { grid-template-columns: repeat(3, minmax(0, 1fr)); column-gap: 3rem; } }
  .include li { display: flex; align-items: baseline; gap: 1rem; padding: 1.15rem 0; border-bottom: 1px solid var(--linea); font-weight: 500; line-height: 1.45; }
  .num { flex-shrink: 0; color: var(--accent); font-size: var(--fs-sm); font-weight: 600; font-variant-numeric: tabular-nums; letter-spacing: 0.05em; }

  /* Il percorso a gradini */
  #percorso { scroll-margin-top: 5rem; }
  .percorso { padding-block: clamp(2rem, 5vw, 4.5rem); }
  .percorso-testa { display: grid; gap: 2rem; margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  @media (min-width: 64rem) { .percorso-testa { grid-template-columns: minmax(0, 26rem) minmax(0, 1fr); align-items: end; } }
  .percorso .sfalsato { color: var(--white); }
  .scala { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.75rem; }
  .scala li { padding-top: 1.1rem; border-top: 1px solid var(--linea); margin-left: calc(var(--gm) * 14%); }
  @media (min-width: 40rem) and (max-width: 63.99rem) { .scala li { width: 70%; margin-left: calc(var(--gm) * 30%); } }
  @media (min-width: 64rem) {
    .scala { grid-template-columns: var(--colonne); gap: 3rem 2.5rem; align-items: start; }
    /* ogni fase scende di un gradino rispetto alla precedente */
    .scala li { margin: calc(var(--g) * clamp(5rem, 9vw, 9rem)) 0 0; }
  }
  .scala .num { display: block; margin-bottom: 0.9rem; font-size: var(--fs-lg); color: var(--text); }
  .domanda { margin: 0 0 0.35rem; color: var(--muted); font-size: var(--fs-sm); }
  .scala h3 { margin: 0 0 0.6rem; font-family: var(--font-display); font-size: clamp(1.15rem, 1.8vw, 1.5rem); font-weight: 600; text-transform: uppercase; color: var(--accent); line-height: 1.2; }
  .scala li > p:last-child { margin: 0 0 1.5rem; color: var(--text-soft); font-size: var(--fs-sm); line-height: 1.65; max-width: 30rem; }

  /* Progetti */
  .progetti { display: flex; flex-wrap: wrap; gap: 1.5rem; }
  .progetti > :global(*) { flex: 0 1 100%; }
  .progetti > :global(.card) { height: auto; }
  @media (min-width: 40rem) { .progetti > :global(*) { flex-basis: calc((100% - 1.5rem) / 2); } }
  @media (min-width: 64rem) { .progetti > :global(*) { flex-basis: calc((100% - 3rem) / 3); } }

  /* Dopo la consegna e altri servizi */
  .dopo .sfalsato { color: var(--white); }
  .altri { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--linea); }
  .altri a { display: grid; grid-template-columns: 2.75rem minmax(0, 1fr) auto; align-items: center; gap: 1rem; padding: 1.25rem 0; border-top: 1px solid var(--linea); color: var(--text); text-decoration: none; transition: color 0.25s, padding 0.3s; }
  .altri .nome { font-family: var(--font-display); font-size: clamp(1.2rem, 2.6vw, 2.1rem); font-weight: 600; text-transform: uppercase; line-height: 1.15; }
  .altri .freccia { font-size: 1.5rem; transition: transform 0.3s; }
  .altri a:hover { color: var(--accent); padding-left: 0.75rem; }
  .altri a:hover .freccia { transform: translate(4px, -4px); }

  /* Chiamata finale */
  .fondo { margin-bottom: var(--spazio-sezione); }
  .chiusura { display: grid; gap: 2rem; padding-block: clamp(2.5rem, 7vw, 6rem); }
  @media (min-width: 64rem) { .chiusura { grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: end; gap: 3rem; } }
  .chiusura .sfalsato { color: var(--white); }
  .chiusura-lato { display: grid; gap: 2rem; justify-items: start; }
  .grande { display: inline-flex; align-items: center; gap: 0.6rem; padding: 0.95rem 1.75rem; font-family: var(--font-display); letter-spacing: 0.05em; text-transform: uppercase; font-size: var(--fs-sm); }
</style>
