---
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import TagTecnologia from '../../components/TagTecnologia.astro';
import { getProgetti, type Progetto } from '../../lib/wp';
import { getTesti } from '../../lib/testi';
import { ottimizzaImmaginiContenuto } from '../../lib/immaginiContenuto';
import { CMS_URL } from 'astro:env/client';

export const getStaticPaths = (async () => {
  const progetti = await getProgetti();
  return progetti.map((progetto) => ({ params: { slug: progetto.slug }, props: { progetto } }));
}) satisfies GetStaticPaths;

const { progetto: p } = Astro.props as { progetto: Progetto };

const t = (await getTesti()).progetti;
const immagineSocial = p.seo.immagine ?? p.copertina;
const og = immagineSocial
  ? await getImage({ src: immagineSocial.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : undefined;
const contenuto = await ottimizzaImmaginiContenuto(p.contenuto, CMS_URL ?? '');
// Versione grande di ogni immagine della galleria, aperta a tutto schermo al clic.
const grandi = await Promise.all(
  p.galleria.map((g) => getImage({ src: g.src, width: Math.min(g.width ?? 1920, 1920), height: g.width && g.height ? Math.round((Math.min(g.width, 1920) * g.height) / g.width) : undefined, inferSize: !g.width, format: 'webp' })),
);
const conLato = p.funzionalita.length > 0 || p.tecnologie.length > 0 || !!p.risultato;
---

<Base title={p.seo.titolo || p.titolo} description={p.seo.descrizione || p.introduzione || p.estratto} image={og?.src} noindex={p.seo.noindex}>
  <article class="wrap section">
    <div class="intro">
    <div>
      <p><a href="/progetti/">{t.torna}</a></p>
      <h1>{p.titolo}</h1>
      {(p.introduzione || p.estratto) && <p class="lead muted">{p.introduzione || p.estratto}</p>}
    </div>

    <dl class="scheda">
      {p.cliente && <div><dt>{t.label_cliente}</dt><dd>{p.cliente}</dd></div>}
      {p.anno && <div><dt>{t.label_anno}</dt><dd>{p.anno}</dd></div>}
      {p.ruolo && <div class:list={[{ lungo: p.ruolo.length > 24 }]}><dt>{t.label_ruolo}</dt><dd>{p.ruolo}</dd></div>}
      {p.servizi.length > 0 && <div><dt>{t.label_servizi}</dt><dd>{p.servizi.map((s) => s.nome).join(', ')}</dd></div>}
      {p.url && <div><dt>{t.label_online}</dt><dd><a href={p.url} rel="noopener" target="_blank">{t.visita}</a></dd></div>}
    </dl>
    </div>

    {p.copertina && (
      <Image
        class="cover"
        src={p.copertina.src}
        alt={p.copertina.alt || p.titolo}
        width={p.copertina.width ?? 1600}
        height={p.copertina.height ?? 1000}
        widths={[640, 1024, 1600]}
        sizes="(min-width: 72rem) 70rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    )}

    <div class:list={['corpo', { 'con-lato': conLato }]}>
      <div class="principale">
        <div class="prose" set:html={contenuto} />

        {p.galleria.length > 0 && (
          <section class="galleria" aria-labelledby="titolo-galleria">
            <h2 id="titolo-galleria">{t.galleria_titolo}</h2>
            <ul data-galleria>
              {p.galleria.map((g, i) => (
                <li>
                  <a href={grandi[i].src} data-indice={i} aria-label={`Apri immagine ${i + 1} di ${p.galleria.length}`}>
                    <Image src={g.src} alt={g.alt || `${p.titolo}, immagine ${i + 1}`} width={g.width ?? 1200} height={g.height ?? 800} widths={[480, 800, 1200]} sizes="(min-width: 64rem) 25vw, (min-width: 40rem) 50vw, 100vw" format="webp" />
                  </a>
                </li>
              ))}
            </ul>
            <dialog class="lightbox" data-lightbox aria-label={t.galleria_titolo}>
              <img alt="" />
              <button class="chiudi" type="button" data-chiudi aria-label="Chiudi">✕</button>
              {p.galleria.length > 1 && <button class="nav prec" type="button" data-passo="-1" aria-label="Immagine precedente">‹</button>}
              {p.galleria.length > 1 && <button class="nav succ" type="button" data-passo="1" aria-label="Immagine successiva">›</button>}
            </dialog>
          </section>
        )}
      </div>

      {conLato && (
        <aside class="lato" aria-label="Scheda del progetto">
          <div class="scheda-lato">
            {p.funzionalita.length > 0 && (
              <section>
                <h2>{t.funzionalita_titolo}</h2>
                <ul class="funzioni">{p.funzionalita.map((f) => <li>{f}</li>)}</ul>
              </section>
            )}
            {p.tecnologie.length > 0 && (
              <section>
                <h2>{t.label_tecnologie}</h2>
                <ul class="tags">{p.tecnologie.map((x) => <TagTecnologia nome={x} />)}</ul>
              </section>
            )}
            {p.risultato && (
              <section class="risultato">
                <h2>{t.label_risultato}</h2>
                <p>{p.risultato}</p>
              </section>
            )}
            <p class="azioni">
              <a class="btn" href="/contatti/">{t.cta_progetto}</a>
              {p.url && p.stato === 'online' && <a class="visita" href={p.url} rel="noopener" target="_blank">{t.visita} ↗</a>}
            </p>
          </div>
        </aside>
      )}
    </div>

    {!conLato && (
      <p class="cta">
        <a class="btn" href="/contatti/">{t.cta_progetto}</a>
      </p>
    )}
  </article>
</Base>

<script>
  // Galleria: il clic apre l'immagine grande; frecce della tastiera, swipe ed Esc per muoversi e chiudere.
  const lista = document.querySelector<HTMLElement>('[data-galleria]');
  const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (lista && box) {
    const link = [...lista.querySelectorAll<HTMLAnchorElement>('a[data-indice]')];
    const img = box.querySelector('img')!;
    let attuale = 0;
    const mostra = (i: number) => {
      attuale = (i + link.length) % link.length;
      img.src = link[attuale].href;
      img.alt = link[attuale].querySelector('img')?.alt ?? '';
    };
    link.forEach((a, i) => a.addEventListener('click', (e) => { e.preventDefault(); mostra(i); box.showModal(); }));
    box.querySelectorAll<HTMLButtonElement>('[data-passo]').forEach((b) => b.addEventListener('click', () => mostra(attuale + Number(b.dataset.passo))));
    box.querySelector('[data-chiudi]')?.addEventListener('click', () => box.close());
    box.addEventListener('click', (e) => { if (e.target === box) box.close(); });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') mostra(attuale + 1);
      if (e.key === 'ArrowLeft') mostra(attuale - 1);
    });
    let x0 = 0;
    box.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    box.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 50 && link.length > 1) mostra(attuale + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .lead { font-size: var(--fs-lg); max-width: 44rem; }
  /* Intestazione: testo a sinistra, dati del progetto a destra (stessa colonna della scheda laterale). */
  .intro { display: grid; gap: 2rem; align-items: end; }
  .scheda { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 8.5rem), 1fr)); gap: 1.25rem 1.5rem; margin: 0; padding: 1.5rem 1.75rem; border-radius: var(--radius); background: color-mix(in srgb, var(--surface) 80%, transparent); border: 1px solid var(--border); backdrop-filter: blur(6px); }
  .scheda > div { display: grid; gap: 0.3rem; align-content: start; }
  .scheda dd { line-height: 1.4; }
  .scheda dd a { white-space: nowrap; }
  /* Il riquadro dei dati prende tutto lo spazio a destra del testo: i dati si dispongono in più colonne. */
  @media (min-width: 64rem) {
    .intro { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 4rem; }
    .scheda { grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); padding: 1.75rem 2rem; align-self: end; }
    .scheda .lungo { grid-column: span 2; } /* un ruolo lungo non va a capo su cinque righe */
  }
  dt { font-size: var(--fs-xs); text-transform: uppercase; letter-spacing: 0.05em; color: var(--muted); }
  dd { margin: 0; font-weight: 600; }
  .cover { width: 100%; height: auto; border-radius: var(--radius); margin: 2.5rem 0; }
  .cta { margin-top: 3rem; }

  /* Testo a sinistra, scheda del progetto a destra (resta visibile scorrendo). */
  .corpo { display: grid; gap: 2.5rem; align-items: start; }
  @media (min-width: 64rem) { .corpo.con-lato { grid-template-columns: minmax(0, 1fr) minmax(20rem, 28rem); gap: 4rem; } }
  /* Accanto alla scheda il testo occupa tutta la sua colonna; sugli schermi grandi cresce anche il carattere per non avere righe troppo lunghe. */
  .con-lato .prose { max-width: none; }
  @media (min-width: 100rem) { .con-lato .prose { font-size: var(--fs-lg); } }
  .lato { position: sticky; top: 6rem; }
  .scheda-lato { display: grid; gap: 1.75rem; padding: 1.75rem; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--border); }
  .scheda-lato section { display: grid; gap: 0.85rem; }
  .scheda-lato h2 { margin: 0; font-family: var(--font); font-size: var(--fs-2xs); font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted); }
  .funzioni { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.7rem; font-size: var(--fs-sm); }
  .funzioni li { display: flex; gap: 0.7rem; align-items: flex-start; }
  .funzioni li::before { content: ''; flex-shrink: 0; margin-top: 0.45rem; width: 0.45rem; height: 0.45rem; border-radius: 50%; background: var(--accent-gradient); }
  .risultato { padding: 1rem 1.1rem; border-radius: calc(var(--radius) * 0.6); background: var(--accent-soft); border: 1px solid var(--accent-border); }
  .risultato p { margin: 0; font-size: var(--fs-sm); line-height: 1.6; }
  .azioni { display: grid; gap: 0.75rem; margin: 0; padding-top: 1.5rem; border-top: 1px solid var(--border); text-align: center; }
  .azioni .btn { font-size: var(--fs-sm); }
  .visita { font-size: var(--fs-sm); color: var(--muted); }
  .visita:hover { color: var(--text); }

  .galleria { margin-top: 4rem; }
  .galleria h2 { font-size: var(--fs-h2); margin: 0 0 1.5rem; }
  .galleria ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .galleria a { display: block; aspect-ratio: 16 / 10; border-radius: calc(var(--radius) * 0.75); overflow: hidden; border: 1px solid var(--border); cursor: zoom-in; }
  .galleria a img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 0.5s ease; }
  .galleria a:hover img { transform: scale(1.03); }

  .lightbox { max-width: 100vw; max-height: 100vh; width: 100vw; height: 100vh; margin: 0; padding: 0; border: 0; background: rgb(0 0 0 / 0.92); }
  .lightbox[open] { display: grid; place-items: center; }
  .lightbox::backdrop { background: transparent; }
  .lightbox img { max-width: min(92vw, 1920px); max-height: 88vh; width: auto; height: auto; border-radius: 8px; }
  .lightbox button { position: absolute; display: grid; place-items: center; width: 3rem; height: 3rem; border: 1px solid rgb(255 255 255 / 0.2); border-radius: 50%; background: rgb(255 255 255 / 0.08); color: var(--white); font-size: 1.5rem; line-height: 1; cursor: pointer; }
  .lightbox button:hover { background: rgb(255 255 255 / 0.18); }
  .chiudi { top: 1rem; right: 1rem; font-size: 1.1rem !important; }
  .nav { top: 50%; translate: 0 -50%; }
  .prec { left: 1rem; }
  .succ { right: 1rem; }
</style>
