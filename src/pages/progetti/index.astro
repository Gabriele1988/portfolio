---
import Base from '../../layouts/Base.astro';
import ProgettoCard from '../../components/ProgettoCard.astro';
import { getProgetti } from '../../lib/wp';

const progetti = await getProgetti();
---

<Base title="Progetti" description="Una selezione di lavori: il problema, la soluzione e il risultato.">
  <section class="wrap section">
    <h1>Progetti</h1>
    <p class="muted">Per ogni lavoro racconto il problema, la soluzione e il risultato.</p>
    {progetti.length ? (
      <div class="grid">
        {progetti.map((p, i) => <ProgettoCard progetto={p} eager={i === 0} />)}
      </div>
    ) : (
      <p>I progetti arriveranno presto.</p>
    )}
  </section>
</Base>
