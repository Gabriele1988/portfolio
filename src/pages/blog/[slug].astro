---
// Pagina di un articolo del blog: titolo, data e tempo di lettura, immagine in evidenza, testo,
// tag, invito al contatto e altri articoli.
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { CMS_URL } from 'astro:env/client';
import Base from '../../layouts/Base.astro';
import ArticoloCard from '../../components/ArticoloCard.astro';
import Icona from '../../components/Icona.astro';
import { dataItaliana, getArticoli, type Articolo } from '../../lib/blog';
import { stripTags } from '../../lib/wp';
import { getTesti } from '../../lib/testi';
import { ottimizzaImmaginiContenuto } from '../../lib/immaginiContenuto';

export const getStaticPaths = (async () => {
  const articoli = await getArticoli();
  return articoli.map((articolo) => ({ params: { slug: articolo.slug }, props: { articolo } }));
}) satisfies GetStaticPaths;

const { articolo: a } = Astro.props as { articolo: Articolo };
const [tutti, testi] = await Promise.all([getArticoli(), getTesti()]);
const g = testi.generale;
// Altri articoli: prima quelli con tag in comune, poi i più recenti.
const comuni = (b: Articolo) => b.tag.filter((t) => a.tag.includes(t)).length;
const altri = tutti
  .filter((b) => b.slug !== a.slug)
  .map((b, i) => ({ b, punti: comuni(b) * 100 - i }))
  .sort((x, y) => y.punti - x.punti)
  .slice(0, 3)
  .map((x) => x.b);

// Indice: ogni <h2> del testo riceve un id (dal titolo) e diventa una voce numerata.
const slugTitolo = (t: string) =>
  t.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/<[^>]*>/g, '').replace(/&[^;]+;/g, ' ').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 60) || 'sezione';
const indice: { id: string; titolo: string }[] = [];
const conId = a.contenuto.replace(/<h2\b([^>]*)>([\s\S]*?)<\/h2>/gi, (_m, attr: string, html: string) => {
  const titolo = stripTags(html);
  const esistente = attr.match(/\sid\s*=\s*"([^"]+)"/i)?.[1];
  let id = esistente || slugTitolo(titolo);
  while (!esistente && indice.some((v) => v.id === id)) id += '-2';
  indice.push({ id, titolo });
  const n = String(indice.length).padStart(2, '0');
  return `<h2${esistente ? attr : `${attr} id="${id}"`} data-n="${n}">${html}</h2>`;
});
const conIndice = indice.length >= 2;

// Cielo della fascia del titolo: stelle in posizioni fisse per ogni articolo (stesso articolo, stesso cielo).
let semeN = [...a.slug].reduce((x, c) => (Math.imul(x, 31) + c.charCodeAt(0)) >>> 0, 11);
const rnd = () => ((semeN = (Math.imul(semeN, 1103515245) + 12345) >>> 0) / 4294967296);
const seme = semeN % 1000;
const rot = Math.round(-28 + rnd() * 16); // nebulosa in diagonale, come una scia
const cielo = (n: number, colore: () => string) =>
  Array.from({ length: n }, () => `${Math.round(rnd() * 2400)}px ${Math.round(rnd() * 520)}px ${colore()}`).join(',');
const stelle1 = cielo(260, () => `rgb(255 255 255 / ${(0.25 + rnd() * 0.5).toFixed(2)})`);
const stelle2 = cielo(60, () => (rnd() < 0.3 ? 'rgb(214 190 255 / .9)' : 'rgb(255 255 255 / .85)'));
const stelle3 = cielo(14, () => 'rgb(255 255 255)');
const contenuto = await ottimizzaImmaginiContenuto(conId, CMS_URL ?? '');
const og = a.copertina ? await getImage({ src: a.copertina.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' }) : undefined;
const url = new URL(Astro.url.pathname, Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: a.titolo,
      description: a.descrizione,
      datePublished: a.data,
      dateModified: a.modificato,
      mainEntityOfPage: url,
      url,
      inLanguage: 'it-IT',
      image: og ? new URL(og.src, Astro.site).href : undefined,
      keywords: a.tag.join(', ') || undefined,
      author: { '@type': 'Person', name: g.nome, url: new URL('/chi-sono-web-designer-palermo/', Astro.site).href },
      publisher: { '@type': 'Person', name: g.nome, url: new URL('/', Astro.site).href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).href },
        { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
        { '@type': 'ListItem', position: 3, name: a.titolo, item: url },
      ],
    },
  ],
};
---

<Base title={a.titolo} description={a.descrizione} image={og?.src}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <meta slot="head" property="og:type" content="article" />
  <link slot="head" rel="alternate" type="application/rss+xml" title="Blog" href="/blog/rss.xml" />

  <header class="banner" style={`--rot: ${rot}deg`}>
    <div class="cielo" aria-hidden="true">
      <svg class="nebulosa" viewBox="0 0 1600 500" preserveAspectRatio="xMidYMid slice">
        <defs>
          <filter id="nb-filtro" x="0" y="0" width="100%" height="100%">
            <feTurbulence type="fractalNoise" baseFrequency="0.0025 0.012" numOctaves="5" seed={seme} />
            <feColorMatrix values="0 0 0 0 0.62  0 0 0 0 0.42  0 0 0 0 1  0 0 0 3.4 -1.55" />
          </filter>
          <radialGradient id="nb-maschera-g" cx="0.78" cy="0.45" r="0.55">
            <stop offset="0" stop-color="#fff" />
            <stop offset="0.6" stop-color="#fff" stop-opacity="0.55" />
            <stop offset="1" stop-color="#fff" stop-opacity="0" />
          </radialGradient>
          <mask id="nb-maschera"><rect width="1600" height="500" fill="url(#nb-maschera-g)" /></mask>
        </defs>
        <rect width="1600" height="500" filter="url(#nb-filtro)" mask="url(#nb-maschera)" />
      </svg>
      <span class="bagliore b1"></span>
      <span class="bagliore b2"></span>
      <span class="bagliore b3"></span>
      <span class="stelle s1" style={`box-shadow: ${stelle1}`}></span>
      <span class="stelle s2" style={`box-shadow: ${stelle2}`}></span>
      <span class="stelle s3" style={`box-shadow: ${stelle3}`}></span>
      <span class="cometa"></span>
    </div>
    <div class="wrap testa">
      <h1>{a.titolo}</h1>
      <nav class="briciole" aria-label="Percorso">
        <a href="/">Home</a>
        <Icona nome="arrowRight" size={16} />
        <a href="/blog/">Blog</a>
        <Icona nome="arrowRight" size={16} />
        <span aria-current="page">{a.titolo}</span>
      </nav>
    </div>
  </header>

  <article class="wrap section articolo">
    <p class="meta">
      <time datetime={a.data}>{dataItaliana(a.data)}</time>
      <span>{a.minuti} min di lettura</span>
      {a.tag.length > 0 && <span class="cat">{a.tag.join(', ')}</span>}
    </p>

    <div class:list={['corpo', { 'con-indice': conIndice }]}>
      {conIndice && (
        <nav class="indice" aria-label="Indice dell'articolo" data-indice>
          <details open>
            <summary>Indice <span class="conta">{indice.length} sezioni</span></summary>
            <ol>
              {indice.map((v, i) => (
                <li><a href={`#${v.id}`} data-voce={v.id}><span class="n">{String(i + 1).padStart(2, '0')}</span><span>{v.titolo}</span></a></li>
              ))}
            </ol>
          </details>
        </nav>
      )}

      <div class="principale">
        <div class="prose testo" set:html={contenuto} />

        {a.tag.length > 0 && (
          <ul class="tags argomenti" aria-label="Argomenti">
            {a.tag.map((t) => <li>{t}</li>)}
          </ul>
        )}

        <aside class="invito">
          <p class="invito-titolo">Vuoi applicarlo al tuo sito?</p>
          <p class="muted">Raccontami la tua attività: ti dico cosa conviene fare, con tempi e costi chiari.</p>
          <a class="btn" href="/contatti/">Chiedi un parere <Icona nome="arrowRight" /></a>
        </aside>
      </div>
    </div>
  </article>

  <script>
    // Indice: evidenzia la sezione che si sta leggendo. Su telefono l'indice parte chiuso.
    const nav = document.querySelector<HTMLElement>('[data-indice]');
    if (nav) {
      const det = nav.querySelector('details')!;
      if (!matchMedia('(min-width: 64rem)').matches) det.open = false;
      const voci = [...nav.querySelectorAll<HTMLAnchorElement>('[data-voce]')];
      const titoli = voci.map((v) => document.getElementById(v.dataset.voce!)).filter((t): t is HTMLElement => !!t);
      const attiva = () => {
        let corrente = titoli[0];
        for (const t of titoli) if (t.getBoundingClientRect().top < innerHeight * 0.3) corrente = t;
        voci.forEach((v) => v.classList.toggle('attiva', v.dataset.voce === corrente?.id));
      };
      let attesa = false;
      addEventListener('scroll', () => {
        if (attesa) return;
        attesa = true;
        requestAnimationFrame(() => { attesa = false; attiva(); });
      }, { passive: true });
      attiva();
      voci.forEach((v) => v.addEventListener('click', () => { if (!matchMedia('(min-width: 64rem)').matches) det.open = false; }));
    }
  </script>

  {altri.length > 0 && (
    <section class="wrap section altri">
      <h2 class="titolo-sezione">Altri <span class="evidenza">articoli</span></h2>
      <div class="griglia">
        {altri.map((b) => <ArticoloCard articolo={b} livello="h3" />)}
      </div>
      <p class="tutti"><a class="btn btn-ghost" href="/blog/">Tutti gli articoli <Icona nome="arrowRight" /></a></p>
    </section>
  )}
</Base>

<style>
  /* ---------- Fascia del titolo: cielo stellato con nebulosa viola, animato ---------- */
  .banner { position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(120% 140% at 85% 30%, rgb(42 16 74) 0%, rgb(16 8 28) 45%, rgb(7 6 12) 75%); border-bottom: 1px solid var(--border); }
  .cielo { position: absolute; inset: 0; z-index: -1; pointer-events: none; }
  .nebulosa { position: absolute; inset: -10% -5%; width: 110%; height: 120%; opacity: 0.85; transform: rotate(var(--rot)); will-change: transform; animation: deriva 60s ease-in-out infinite alternate; }
  .bagliore { position: absolute; border-radius: 50%; filter: blur(40px); mix-blend-mode: screen; animation: respiro 14s ease-in-out infinite alternate; }
  .b1 { width: 38rem; height: 16rem; right: 2%; top: 10%; background: radial-gradient(closest-side, rgb(140 70 255 / .55), transparent); rotate: -25deg; }
  .b2 { width: 22rem; height: 12rem; right: 22%; top: 45%; background: radial-gradient(closest-side, rgb(229 0 255 / .28), transparent); animation-duration: 18s; animation-delay: -6s; }
  .b3 { width: 30rem; height: 10rem; left: 30%; bottom: -10%; background: radial-gradient(closest-side, rgb(97 9 250 / .3), transparent); rotate: 12deg; animation-duration: 22s; }
  .stelle { position: absolute; top: 0; left: 0; width: 1px; height: 1px; border-radius: 50%; }
  .s1 { animation: brilla 7s ease-in-out infinite alternate; }
  .s2 { width: 2px; height: 2px; animation: brilla 4.5s ease-in-out infinite alternate-reverse; }
  .s3 { width: 3px; height: 3px; filter: drop-shadow(0 0 4px rgb(200 170 255)); animation: brilla 3s ease-in-out infinite alternate; }
  .cometa { position: absolute; top: 18%; left: 55%; width: 140px; height: 1.5px; background: linear-gradient(90deg, transparent, rgb(240 138 255)); rotate: -18deg; opacity: 0; animation: cometa 9s ease-in 2s infinite; }
  @keyframes deriva { from { transform: rotate(var(--rot)) scale(1) translate3d(0, 0, 0); } to { transform: rotate(calc(var(--rot) + 3deg)) scale(1.08) translate3d(-3%, 2%, 0); } }
  @keyframes respiro { from { opacity: 0.6; transform: translate3d(0, 0, 0) scale(1); } to { opacity: 1; transform: translate3d(-4%, 3%, 0) scale(1.12); } }
  @keyframes brilla { from { opacity: 0.45; } to { opacity: 1; } }
  @keyframes cometa { 0% { opacity: 0; translate: 0 0; } 4% { opacity: 1; } 12% { opacity: 0; translate: -340px 110px; } 100% { opacity: 0; translate: -340px 110px; } }
  @media (prefers-reduced-motion: reduce) { .nebulosa, .bagliore, .stelle, .cometa { animation: none; } }

  .testa { position: relative; padding-block: clamp(3.5rem, 9vw, 7rem) clamp(2.5rem, 6vw, 4.5rem); }
  h1 { max-width: 22ch; font-size: clamp(2.2rem, 5.5vw, 4.5rem); line-height: 1.05; margin: 0 0 2.25rem; text-wrap: balance; color: var(--white); text-shadow: 0 2px 30px rgb(0 0 0 / .45); }
  .briciole { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1rem; font-weight: 500; font-size: var(--fs-sm); color: var(--white); }
  .briciole a { color: var(--white); text-decoration: none; }
  .briciole a:hover { color: var(--accent-glow); }
  .briciole :global(svg) { color: var(--accent-glow); flex-shrink: 0; }
  .briciole [aria-current] { color: rgb(255 255 255 / .75); max-width: 32ch; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .articolo { padding-top: clamp(2rem, 5vw, 3.5rem); }
  .meta { display: flex; flex-wrap: wrap; gap: 0.5rem 2.5rem; margin: 0 0 2.5rem; font-size: var(--fs-sm); color: var(--muted); }
  .meta .cat { color: var(--accent-light); }
  .testo { max-width: none; margin: 0; font-size: 1.125rem; line-height: 1.75; }
  @media (min-width: 100rem) { .testo { font-size: var(--fs-lg); } }
  .testo :global(h2) { font-size: var(--fs-h2); line-height: 1.2; margin: 2.75rem 0 1rem; }
  .testo :global(h3) { font-size: var(--fs-lg); margin: 2rem 0 0.75rem; }
  .testo :global(p), .testo :global(ul), .testo :global(ol) { margin: 0 0 1.25rem; }
  .testo :global(li) { margin-bottom: 0.5rem; }
  .testo :global(a) { color: var(--accent-light); text-underline-offset: 3px; }
  .testo :global(strong) { color: var(--text); }
  .testo :global(blockquote) { margin: 2rem 0; padding: 1rem 1.5rem; border-left: 3px solid var(--accent); background: var(--accent-soft); border-radius: 0 var(--radius) var(--radius) 0; }
  .testo :global(blockquote p:last-child) { margin-bottom: 0; }
  .argomenti { margin: 2rem 0 0; }

  /* ---------- Indice ---------- */
  .corpo { display: grid; gap: 2rem; }
  @media (min-width: 64rem) { .corpo.con-indice { grid-template-columns: 17rem minmax(0, 1fr); gap: 4rem; align-items: start; } }
  .indice { position: relative; }
  @media (min-width: 64rem) { .indice { position: sticky; top: 6.5rem; max-height: calc(100vh - 8rem); overflow-y: auto; } }
  /* Niente font monospazio in questa pagina: sarebbe un file in più da scaricare (PageSpeed). */
  .indice details { border-block: 1px solid var(--border); padding-top: 1.25rem; }
  .indice details:not([open]) summary { margin-bottom: 1.25rem; }
  @media (min-width: 64rem) { .indice details { border-bottom: 0; } }
  .indice summary { display: flex; align-items: baseline; justify-content: space-between; list-style: none; cursor: pointer; font-variant-numeric: tabular-nums; font-weight: 600; font-size: var(--fs-2xs); letter-spacing: 0.2em; text-transform: uppercase; color: var(--accent); margin-bottom: 1.25rem; }
  .indice summary::-webkit-details-marker { display: none; }
  .indice summary::after { content: '+'; font-size: 1rem; letter-spacing: 0; }
  .indice details[open] summary::after { content: '−'; }
  .conta { margin-left: auto; margin-right: 0.75rem; letter-spacing: 0.08em; color: var(--muted); }
  @media (min-width: 64rem) { .indice summary { pointer-events: none; } .indice summary::after, .conta { display: none; } }
  .indice ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .indice a { display: grid; grid-template-columns: 2rem 1fr; gap: 0.5rem; padding: 0.6rem 0.75rem 0.6rem 0.9rem; border-left: 2px solid var(--border); color: var(--text-soft); text-decoration: none; font-size: var(--fs-sm); line-height: 1.35; font-weight: 600; transition: border-color 0.25s, color 0.25s, background-color 0.25s; }
  .indice a:hover { color: var(--text); border-left-color: var(--accent-border); }
  .indice a.attiva { color: var(--text); border-left: 3px solid var(--accent-light); background: var(--accent-soft); }
  .indice .n { font-variant-numeric: tabular-nums; font-weight: 600; font-size: var(--fs-xs); color: var(--accent); padding-top: 0.1em; }

  /* Titoli di sezione numerati, con una riga sopra (come le voci dell'indice) */
  .testo :global(h2[data-n]) { scroll-margin-top: 6rem; position: relative; padding-top: 3.25rem; margin-top: 3.5rem; }
  .testo :global(h2[data-n])::before { content: attr(data-n); position: absolute; top: 1.25rem; left: 0; font-variant-numeric: tabular-nums; font-weight: 600; font-size: var(--fs-xs); font-weight: 400; letter-spacing: 0.1em; color: var(--accent); }
  .testo :global(h2[data-n])::after { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 1px; background: linear-gradient(90deg, var(--accent-border), var(--border) 40%, transparent); }
  .invito { margin: 3rem 0 0; padding: 2rem; display: grid; gap: 0.75rem; justify-items: start; border-radius: var(--radius); background: var(--surface); border: 1px solid var(--accent-border); }
  .invito p { margin: 0; }
  .invito-titolo { font-family: var(--font-display); font-size: var(--fs-lg); }
  .invito .btn { margin-top: 0.5rem; }
  .altri { padding-top: 0; }
  .titolo-sezione { text-align: center; font-size: var(--fs-section); margin: 0 0 3rem; }
  .griglia { display: grid; gap: 1.5rem; }
  @media (min-width: 40rem) { .griglia { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .griglia { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2rem; } }
  .tutti { text-align: center; margin-top: 2.5rem; }
</style>
