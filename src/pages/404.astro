---
import Base from '../layouts/Base.astro';
import { getTesti } from '../lib/testi';

const t = (await getTesti()).notfound;
---

<Base title={t.titolo}>
  <section class="wrap section">
    <h1>{t.titolo}</h1>
    <p>{t.testo}</p>
    <p><a class="btn" href="/">{t.pulsante}</a></p>
  </section>
</Base>
