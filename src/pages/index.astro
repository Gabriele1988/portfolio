---
import Base from '../layouts/Base.astro';
import HeroFluid from '../components/HeroFluid.astro';
import ProgettoCard from '../components/ProgettoCard.astro';
import { getProgettiInEvidenza } from '../lib/wp';

const progetti = await getProgettiInEvidenza(3);
---

<Base overlayHeader>
  <HeroFluid />

  <section id="lavori" class="wrap section">
    <h2>Progetti in evidenza</h2>
    {progetti.length > 0 ? (
      <div class="grid">
        {progetti.map((p) => <ProgettoCard progetto={p} />)}
      </div>
    ) : (
      <p class="muted">I progetti arriveranno presto.</p>
    )}
  </section>
</Base>
