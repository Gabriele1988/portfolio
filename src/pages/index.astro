---
import Base from '../layouts/Base.astro';
import HeroFluid from '../components/HeroFluid.astro';
import ProgettoCard from '../components/ProgettoCard.astro';
import ServiziHome from '../components/ServiziHome.astro';
import { getHome, getProgettiInEvidenza } from '../lib/wp';
import { getTesti } from '../lib/testi';

const [home, progetti, testi] = await Promise.all([getHome(), getProgettiInEvidenza(4), getTesti()]);
const h = testi.home;
---

<Base overlayHeader title={h.meta_titolo || undefined} description={h.meta_descrizione || undefined}>
  <HeroFluid />

  <ServiziHome servizi={home.servizi} />

  <section id="lavori" class="wrap section">
    <h2>{h.progetti_titolo}</h2>
    {progetti.length > 0 ? (
      <div class="progetti-home">
        {progetti.map((p) => <ProgettoCard progetto={p} testi={testi.progetti} />)}
      </div>
    ) : (
      <p class="muted">{h.progetti_vuoto}</p>
    )}
  </section>
</Base>

<style>
  /* I progetti in evidenza riempiono sempre tutta la riga: 3 su desktop e telefono (1 colonna),
     4 su tablet in 2 righe da 2 (se ce ne sono solo 3, l'ultimo va al centro). */
  .progetti-home { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; }
  .progetti-home > :global(*) { flex: 0 1 100%; }
  .progetti-home > :global(.card) { height: auto; } /* height:auto così le card di una riga si allungano tutte uguali */
  @media (min-width: 40rem) { .progetti-home > :global(*) { flex-basis: calc((100% - 1.5rem) / 2); } }
  @media (min-width: 64rem) { .progetti-home > :global(*) { flex-basis: calc((100% - 3rem) / 3); } }
  /* Il quarto si vede solo su tablet */
  @media not ((min-width: 40rem) and (max-width: 63.99rem)) { .progetti-home > :global(:nth-child(4)) { display: none; } }
</style>
