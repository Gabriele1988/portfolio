---
import Base from '../layouts/Base.astro';
import HeroFluid from '../components/HeroFluid.astro';
import ProgettoCard from '../components/ProgettoCard.astro';
import ServiziHome from '../components/ServiziHome.astro';
import { getHome, getProgettiInEvidenza } from '../lib/wp';

const [home, progetti] = await Promise.all([getHome(), getProgettiInEvidenza(3)]);
---

<Base overlayHeader>
  <HeroFluid />

  <ServiziHome servizi={home.servizi} />

  <section id="lavori" class="wrap section">
    <h2>Progetti in evidenza</h2>
    {progetti.length > 0 ? (
      <div class="grid">
        {progetti.map((p) => <ProgettoCard progetto={p} />)}
      </div>
    ) : (
      <p class="muted">I progetti arriveranno presto.</p>
    )}
  </section>
</Base>
