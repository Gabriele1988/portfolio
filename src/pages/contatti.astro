---
import Base from '../layouts/Base.astro';
import ContattoForm from '../components/ContattoForm.astro';
import { getTesti } from '../lib/testi';

const { generale: g, contatti: t } = await getTesti();
---

<Base title={t.meta_titolo} description={t.meta_descrizione}>
  <section class="wrap section">
    <h1>{t.titolo}</h1>
    <p class="muted">
      {t.intro}
      {g.email && <> <a href={`mailto:${g.email}`}>{g.email}</a>.</>}
    </p>
    <ContattoForm />
  </section>
</Base>
