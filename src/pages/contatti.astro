---
import Base from '../layouts/Base.astro';
import ContattoForm from '../components/ContattoForm.astro';
import { sito } from '../site.config';
---

<Base title="Contatti" description="Raccontami il tuo progetto: rispondo entro un giorno lavorativo.">
  <section class="wrap section">
    <h1>Richiedi un preventivo</h1>
    <p class="muted">
      Raccontami il tuo progetto, rispondo entro un giorno lavorativo. Oppure scrivi a
      <a href={`mailto:${sito.email}`}>{sito.email}</a>.
    </p>
    <ContattoForm />
  </section>
</Base>
