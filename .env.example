# Copia in .env per lo sviluppo locale. Su GitHub vanno in
# Settings → Secrets and variables → Actions → Variables.

# Indirizzo pubblico del sito Astro (senza slash finale)
SITE_URL=https://visonuovomdb.com

# Indirizzo del WordPress headless (senza slash finale)
CMS_URL=https://cms.visonuovomdb.com

# true = robots.txt blocca tutto + meta noindex su ogni pagina
NOINDEX=true

# Facoltativo: site key pubblica di Cloudflare Turnstile per il form
TURNSTILE_SITE_KEY=
